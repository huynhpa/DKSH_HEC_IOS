@{
    ViewBag.Title = "Customer Data Integrity";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var userDto = (DKSHApplication.DTO.UserDto)Session["USER_SESSION"];
}
@*
<link rel="stylesheet" type="text/css" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.6.3/css/font-awesome.min.css">
<link href="http://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.1/summernote.css" rel="stylesheet">
<script src="/plugins/Summer-Note/summernote.js"></script>*@
<style type="text/css">
    .btn-file {
        position: relative;
        overflow: hidden;
    }
    .dateControl {
    }
    .editor {
    }
    .fix-modal-body {
        overflow-y: scroll;
        max-height: 550px;
    }

    .fix-bottom {
        margin-bottom: 10px;
    }
    th, td {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    #tblCDI th, #tblCH th {
        text-align: center;
        vertical-align: middle;
    }
    #tblCDI td, #tblCH td {
        vertical-align: middle;
        cursor: pointer;
    }
    .color-col {
        background-color: #C2EEFA;
    }
    .success-input {
        border-color: #00a65a;
    }
    .error-input {
        border-color: #dd4b39;
    }
    .fix-chk-mg {
        margin-top: 22px;
    }
    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        color: #dd4b39;
    }
    .color-col-1 {
        background-color: #99ccff;
    }
    .color-col-2 {
        background-color: #ffcc99;
    }
    .color-col-3 {
        background-color: #07AD46;
    }
    .color-col-4 {
        background-color: #F0D10D;
    }
    .color-col-5 {
        background-color: #FCCFE2;
    }
    .color-col-6 {
        background-color: #cc9900;
    }
    .color-col-7 {
        background-color: #30CEF8;
    }
    .color-col-8 {
        background-color: #99d6ff;
    }
    .color-col-9 {
        background-color: #a3c2c2;
    }
    .color-col-10 {
        background-color: #ffffcc;
    }
    .color-col-11 {
        background-color: #DEB966;
    }
    .color-col-12 {
        background-color: #45B9F7;
    }
    .color-col-13 {
        background-color: #ff6699;
    }
    .color-col-14 {
        background-color: #739900;
    }
    .color-col-15 {
        background-color: #85E306;
    }
    .color-col-16 {
        background-color: #F0D10D;
    }
</style>
<!-- angular js -->
<script src="/Scripts/Controller/CDIController.js"></script>
<input type="hidden" value="@userDto.UserId" id="userIdSession"/>
<div class="ng-cloak" ng-controller="CdiController">
<section class="content-header">
    <h1>Sold to Licenses
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i>Home</a></li>
        <li class="active">Sold to Licenses</li>
    </ol>
</section>
<section class="content">
    <!-- CDI -->
    <div class="box box-info">
        <div class="box-header with-border">
            <h3 class="box-title">Search</h3>
            <div class="box-tools pull-right">
            @if (userDto != null && (userDto.Team.Equals("CDI") || userDto.RoleId.Equals("ADMIN")))
            {
                <a href="@Url.Action("CDISummary", "DashboardCDI")" class="btn btn-link">Dashboard Sold to</a>
                <a href="@Url.Action("ShipToSummary", "DashboardCDI")" class="btn btn-link">Dashboard Ship to</a>
            }
                <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
            </div>
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            <form ng-submit="SearchCdi()" name="formSearch" method="get">
                <div class="col-md-12">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Customer code</label>
                            <input type="text" class="form-control" id="txtCustCode" ng-model="cdiModel.CustCode" ng-change="SetPaging()" />
                        </div>
                    </div>
                    @if (userDto != null && (userDto.Team.Equals("CDI") || userDto.RoleId.Equals("ADMIN")))
                    {
                    <div class="col-md-3">
                        <label>License Expired YES/NO</label>
                        <select class="form-control select2" style="width: 100%;" ng-model="cdiModel.ExpiredYN">
                            <option value="0">CÒN THỜI HẠN</option>
                            <option value="1">HẾT HẠN</option>
                            <option value="2">SẮP HẾT HẠN</option>
                        </select>
                    </div>
                    <div class="col-md-2" ng-show="cdiModel.ExpiredYN == '0' || cdiModel.ExpiredYN == '1' || cdiModel.ExpiredYN == '2'">
                        <div class="form-group">
                            <label>Date : From</label>
                            <div class="input-group date">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input type="text" class="form-control dateControl" id="dtDateExpiredFrom" ng-model="cdiModel.DateExpiredFrom"
                                       data-format="dd-mm-yyyy" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2" ng-show="cdiModel.ExpiredYN == '0' || cdiModel.ExpiredYN == '1' || cdiModel.ExpiredYN == '2'">
                        <div class="form-group">
                            <label>To</label>
                            <div class="input-group date">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input type="text" class="form-control dateControl" id="dtDateExpiredTo" ng-model="cdiModel.DateExpiredTo"
                                       data-format="dd-mm-yyyy" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>License type</label>
                            <select class="form-control select2" style="width: 100%;" multiple="multiple" id="ddlCertification"
                                    ng-model="cdiModel.Certification">
                                <option value="GCNDDKKDD">GCN đủ điều kiện kinh doanh dược</option>
                                <option value="GPP">GPP</option>
                                <option value="GDP">GDP</option>
                                <option value="GSP">GSP</option>
                                <option value="KCB">Khám chữa bệnh</option>
                                <option value="GCNDDKTC">GCN Đủ điều kiện tiêm chủng</option>
                            </select>
                        </div>
                    </div>
                    }
                </div>
                <div class="col-md-12">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Đủ điều kiện xuất bán</label>
                            <select class="form-control select2" style="width: 100%;" multiple="multiple" id="ddlDDKXB"
                                    ng-model="cdiModel.DDKXB">
                                <option ng-repeat="item in DDKXBList" value="{{item.value}}">{{item.label}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>YES/NO</label>
                            <select class="form-control select2" style="width: 100%;" id="ddlDDKXBYN"
                                    ng-model="cdiModel.DDKXBYN">
                                <option value="1">YES</option>
                                <option value="0">NO</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>CGrpCode</label>
                            <select class="form-control select2" style="width: 100%;" multiple="multiple" ng-model="cdiModel.CGrpCode">
                                @foreach (var item in ViewBag.CustGroup)
                                {
                                    <option value="@item.CGrpCode">@item.CGrpCode</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2 fix-chk-mg">
                        <div class="form-group checkbox">
                            <label>
                                <input type="checkbox" ng-model="cdiModel.IsManual" />
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                <span class="label label-warning">
                                    <b data-toggle="tooltip" title="Trường hợp ngoại lệ">
                                        IS MANUAL
                                    </b>
                                </span>
                            </label>
                        </div>
                    </div>
                </div>
                @if (userDto != null && (userDto.Team.Equals("CDI") || userDto.RoleId.Equals("ADMIN")))
                {
                <div class="col-md-12">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Create | Update</label>
                            <select class="form-control select2" style="width: 100%;" id="ddlCreateUpdateBy"
                                    ng-model="cdiModel.CreateUpdateBy">
                                <option value="UPDATE">Update</option>
                                <option value="CREATE">Create</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3" ng-show="cdiModel.CreateUpdateBy == 'CREATE'">
                        <div class="form-group">
                            <label>Create By</label>
                            <select class="form-control select2" style="width:100%"
                                    data-placeholder="Select a user"
                                    ng-model="cdiModel.CreateBy">
                                @foreach (var user in ViewBag.UserTeamCDI)
                                {
                                    <option value="@user.UserId">@user.Fullname</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3" ng-show="cdiModel.CreateUpdateBy == 'UPDATE'">
                        <div class="form-group">
                            <label>Update By</label>
                            <select class="form-control select2" style="width:100%"
                                    data-placeholder="Select a user"
                                    ng-model="cdiModel.UserId">
                                @foreach (var user in ViewBag.UserTeamCDI)
                                {
                                    <option value="@user.UserId">@user.Fullname</option>
                                }
                            </select>
                        </div>
                    </div>
                    <!-- DATE CONTROL -->
                    <div class="col-md-2" ng-show="cdiModel.CreateUpdateBy == 'CREATE'">
                        <div class="form-group">
                            <label>From</label>
                            <div class="input-group date">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input type="text" class="form-control dateControl" ng-model="cdiModel.CreateDateFrom"
                                       data-format="dd-mm-yyyy" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2" ng-show="cdiModel.CreateUpdateBy == 'CREATE'">
                        <div class="form-group">
                            <label>To</label>
                            <div class="input-group date">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input type="text" class="form-control dateControl" ng-model="cdiModel.CreateDateTo"
                                       data-format="dd-mm-yyyy" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2" ng-show="cdiModel.CreateUpdateBy == 'UPDATE'">
                        <div class="form-group">
                            <label>From</label>
                            <div class="input-group date">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input type="text" class="form-control dateControl" ng-model="cdiModel.UpdateDateFrom"
                                       data-format="dd-mm-yyyy" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2" ng-show="cdiModel.CreateUpdateBy == 'UPDATE'">
                        <div class="form-group">
                            <label>To</label>
                            <div class="input-group date">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input type="text" class="form-control dateControl" ng-model="cdiModel.UpdateDateTo"
                                       data-format="dd-mm-yyyy" />
                            </div>
                        </div>
                    </div>
                    <!-- DATE CONTROL -->
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Ship to</label>
                            <input type="text" class="form-control" id="txtShipTo" ng-model="cdiModel.ShipTo" />
                        </div>
                    </div>
                </div>
                }
                <div class="col-md-12">
                    @if (userDto != null && (userDto.Team.Equals("CDI") || userDto.RoleId.Equals("ADMIN")))
                    {
                        <div class="col-md-2 pull-left">
                            <div class="form-group">
                                <button type="button" class="btn btn-block btn-success btn-sm" id="btnAdd"
                                        data-backdrop="static" data-keyboard="false"
                                        ng-click="ClearModel()"
                                        data-target="#modalCDI"
                                        data-toggle="modal">
                                    <strong>New</strong>
                                </button>
                                @*<a href="@Url.Action("New", "CDIManagement")" ng-click="ClearModel()" class="btn btn-success btn-block">New</a>*@
                            </div>
                        </div>
                    }
                    <div class="col-md-2 pull-left">
                        <div class="form-group">
                            <button type="submit" class="btn btn-block btn-primary btn-sm" id="btnSearch">
                                <strong>Search</strong>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-2 pull-left">
                        <div class="form-group">
                            <button type="button" class="btn btn-block btn-warning btn-sm" ng-click="resetForm()">
                                <strong>Clear</strong>
                            </button>
                        </div>
                    </div>
                    @if (userDto != null && (userDto.Team.Equals("CDI") || userDto.RoleId.Equals("ADMIN")))
                    {
                    <div class="col-md-2 pull-right">
                        <div class="form-group">
                            <a href="@Url.Action("ShipTo", "CDIManagement")" class="btn btn-block btn-primary btn-sm">
                                <strong>Ship to</strong>
                            </a>
                        </div>                        
                    </div>
                    <div class="col-md-2 pull-right">
                        <div class="form-group">
                            <button type="button" class="btn btn-block btn-success btn-sm" id="btnExport" ng-click="ExportResult()">
                                <i class="fa fa-file-excel-o"></i> 
                                <strong>Export</strong>
                            </button>
                        </div>
                    </div>
                    }                    
                </div>
            </form>
            <div class="col-md-12">
                <div class="col-md-6">
                    <div class="form-group">
                        <h5>
                            <label>
                                <span class="label label-info"><b>{{totalItems}}</b></span>&nbsp;&nbsp;row(s)
                            </label>
                        </h5>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group pull-right">
                        <simple-pagination current-page="settings.currentPage"
                                            offset="settings.offset"
                                            page-limit="settings.pageLimit"
                                            page-limits="settings.pageLimits"
                                            on-update="callback()"
                                            total="ListCdi.length"></simple-pagination>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
    <div class="box box-info">
        <div class="box-header with-border">
            <h3 class="box-title">Licenses List</h3>
            
            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
            </div>
        </div>
        <div class="box-body">
            <div class="col-md-12 table-responsive no-padding">
                <table id="tblCDI" class="table table-bordered table-striped">
                    <thead>
                        <tr>                            
                            <th rowspan="2">Action</th>                            
                            @if (userDto != null && (userDto.Team.Equals("CDI") || userDto.RoleId.Equals("ADMIN")))
                            {
                            <th rowspan="2" class="color-col-1">Manage by User</th>
                            <th rowspan="2" class="color-col-1">Create by</th>
                            <th rowspan="2" class="color-col-1">Create date</th>
                            <th rowspan="2" class="color-col-1">Update By</th>
                            <th rowspan="2" class="color-col-1">Update date</th>
                            }
                            <th rowspan="2" class="color-col-1">Customer Code</th>
                            <th rowspan="2" class="color-col-1">Customer Name</th>
                            <th colspan="3" class="color-col-2">GPP</th>
                            <th colspan="3" class="color-col-2">GDP</th>
                            <th colspan="3" class="color-col-3">GSP</th>
                            <th rowspan="2" class="color-col-4">TaxCode</th>
                            <th colspan="5" class="color-col-9">GPKD</th>
                            <th rowspan="2" class="color-col-9">Công bố <br/>đủ điều kiện <br/>mua bán <br />TTBYT (COE)</th>
                            <th colspan="3" class="color-col-7">GCN ĐĐKKDD</th>
                            <th colspan="8" class="color-col-8">Phạm vi <br />kinh doanh</th>
                            <th colspan="8" class="color-col-5">Đủ điều kiện<br /> xuất bán</th>
                            <th rowspan="2" class="color-col-16">Is Manual</th>
                            <th colspan="3" class="color-col-11">Giấy phép <br />hoạt động KCB</th>
                            <th rowspan="2" class="color-col-12">Danh mục <br />kỹ thuật <br />có tiêm Botox | Xeomin<br />(Botulinum)</th>
                            <th rowspan="2" class="color-col-12">Đủ điều kiện <br />mua <br/> Botox | Xeomin<br />(Botulinum)</th>                   
                            <th colspan="3" class="color-col-14">GCN <br />đủ điều kiện<br /> tiêm chủng</th>
                            <th rowspan="2" class="color-col-1">Remark</th>
                            <th rowspan="2" class="color-col-1">Address</th>
                            <th rowspan="2" class="color-col-1">District</th>
                            <th rowspan="2" class="color-col-1">ZTerm</th>
                            <th rowspan="2" class="color-col-1">Province</th>
                            <th rowspan="2" class="color-col-1">Region</th>
                            <th rowspan="2" class="color-col-1">Channel</th>
                            <th rowspan="2" class="color-col-1">Tel</th>
                            <th rowspan="2" class="color-col-1">CGrpCode</th>
                            <th rowspan="2" class="color-col-1">CGrpName</th>
                            <th rowspan="2" class="color-col-15">Status Licenses</th>
                            <th rowspan="2" class="color-col-16">License type missing</th>
                            <!-- GCN DDKKDD -->
                            <th colspan="3" class="color-col-8">Excluded GCN DDKKDD</th>
                            <th rowspan="2" class="color-col-8">Remark KSDB <br/>GCN DDKKDD</th>
                            <!-- GPP -->
                            <th colspan="3" class="color-col-11">Excluded GPP</th>
                            <th rowspan="2" class="color-col-11">Remark KSDB GPP</th>
                            <th rowspan="2">Action</th>
                        </tr>
                        <tr>
                            <!-- GPP -->
                            <th class="color-col-2">From</th>
                            <th class="color-col-2">To</th>
                            <th class="color-col-2">Remaining Days</th>
                            <!-- GDP -->
                            <th class="color-col-2">From</th>
                            <th class="color-col-2">To</th>
                            <th class="color-col-2">Remaining Days</th>
                            <!-- GSP -->
                            <th class="color-col-3">From</th>
                            <th class="color-col-3">To</th>
                            <th class="color-col-3">Remaining Days</th>
                            <!-- GPKD -->
                            <th class="color-col-9">GPKD</th>
                            <th class="color-col-9">Ngành nghề <br />kinh doanh <br />có mua bán TTBYT</th>
                            <th class="color-col-9">CMND</th>
                            <th class="color-col-9">Số GPKD</th>
                            <th class="color-col-9">Người đại diện</th>
                            <!-- GCN DDKKDD -->
                            <th class="color-col-7">From</th>
                            <th class="color-col-7">To</th>
                            <th class="color-col-7">Remaining Days</th>
                            <!-- Phạm vi kinh doanh -->
                            <th class="color-col-8">Thuốc dạng <br />phối hợp <br />có chứa dược chất<br /> gây nghiện</th>
                            <th class="color-col-8">Thuốc độc, <br />nguyên liệu độc <br />làm thuốc</th>
                            <th class="color-col-8">Thuốc dược chất<br /> thuộc danh mục <br />bị cấm sử dụng</th>
                            <th class="color-col-8">Sinh phẩm</th>
                            <th class="color-col-8">Vaccin</th>
                            <th class="color-col-8">RX</th>
                            <th class="color-col-8">OTC</th>
                            <th class="color-col-8">Essential<br />Drug</th>
                            <!-- Đủ điều kiện xuất bán -->
                            <th class="color-col-5">Thuốc dạng <br />phối hợp <br />có chứa dược <br />chất gây nghiện</th>
                            <th class="color-col-5">Thuốc độc, <br />nguyên liệu độc <br />làm thuốc</th>
                            <th class="color-col-5">Thuốc dược chất <br/>thuộc danh mục <br />bị cấm sử dụng</th>
                            <th class="color-col-5">Sinh phẩm</th>
                            <th class="color-col-5">Vaccin</th>
                            <th class="color-col-5">RX</th>
                            <th class="color-col-5">OTC</th>
                            <th class="color-col-5">Essential<br/>Drug</th>
                            <!-- GP hoạt động khám chữa bệnh -->
                            <th class="color-col-11">From</th>
                            <th class="color-col-11">To</th>
                            <th class="color-col-11">Remaining Days</th>
                            <!-- GCN Đủ điều kiện tiêm chủng -->
                            <th class="color-col-14">From</th>
                            <th class="color-col-14">To</th>
                            <th class="color-col-14">Remaining Days</th>
                            <th class="color-col-8">Thuốc dạng <br />phối hợp <br />có chứa dược chất<br /> gây nghiện</th>
                            <th class="color-col-8">Thuốc độc, <br />nguyên liệu độc <br />làm thuốc</th>
                            <th class="color-col-8">Thuốc dược chất<br /> thuộc danh mục <br />bị cấm sử dụng</th>
                            <!-- GPP -->
                            <th class="color-col-11">Thuốc dạng <br />phối hợp <br />có chứa dược chất<br /> gây nghiện</th>
                            <th class="color-col-11">Thuốc độc, <br />nguyên liệu độc <br />làm thuốc</th>
                            <th class="color-col-11">Thuốc dược chất<br /> thuộc danh mục <br />bị cấm sử dụng</th>
                        </tr>
                    </thead>
                    <tbody>
                         <tr ng-repeat="item in filterData = (ListCdi | filter : {CustCode: cdiModel.CustCode} | limitTo:settings.pageLimit:settings.offset)"
