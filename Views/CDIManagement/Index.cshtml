<!-- Modal CDI -->
<!-- BEGIN EDIT AND ADD -->
<div id="modalCDI" class="modal fade" role="dialog">
<form id="register-form" name="formCdi" ng-submit="Save()" novalidate>
    <div class="modal-dialog" style="width: 95%; margin: 25px auto;">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title text-red">CDI Register / Update</h4>
            </div>
            <div class="modal-body fix-modal-body">
                <!-- BEGIN CDI -->
                <div class="box box-info">
                    <div class="box-header with-border">
                        <h3 class="box-title">Customer Code</h3>
                        <div class="box-tools pull-right">
                            <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                        </div>
                    </div>
                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="col-md-12">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="text-red">Customer code *</label>
                                    <input type="text" class="form-control" ng-change="CheckCustCodeExist()" ng-model="cdiData.CustCode" id="txtCustomerCode" required="required" ng-disabled="isUpdate == true" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Tax code</label>
                                    <input type="text" class="form-control" ng-model="cdiData.TaxCode" id="txtTaxCode" />
                                </div>
                            </div>
                            @if (userDto != null && (userDto.Team.Equals("CDI") || userDto.RoleId.Equals("ADMIN")))
                            {
                            <div class="col-md-2" ng-if="isUpdate">
                                <div class="form-group">
                                    <label>Update By</label>
                                    <input type="text" class="form-control" id="txtUpdateBy" disabled ng-model="cdiData.UserId" />
                                </div>
                            </div>
                            <div class="col-md-2" ng-if="isUpdate">
