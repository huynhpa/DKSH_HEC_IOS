                                    </label>
                                    <label ng-if="item.LicenseTaxCode != null &&item.LicenseTaxCode != ''">
                                        <span class="label label-danger"><b>{{item.LicenseTaxCode}}</b></span>
                                    </label>
                                    <label ng-if="item.LicenseKCB != null  && item.LicenseKCB != ''">
                                        <span class="label label-danger"><b>{{item.LicenseKCB}}</b></span>
                                    </label>
