@{
    ViewBag.Title = "ShipTo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var userDto = (DKSHApplication.DTO.UserDto)Session["USER_SESSION"];
}
@*<link rel="stylesheet" type="text/css" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.6.3/css/font-awesome.min.css">
<link href="http://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.1/summernote.css" rel="stylesheet">
<script src="/plugins/Summer-Note/summernote.js"></script>*@
<style type="text/css">
    .btn-file {
        position: relative;
        overflow: hidden;
    }

    .dateControl {
    }

    .editor {
    }

    .fix-modal-body {
        overflow-y: scroll;
        max-height: 550px;
    }

    .fix-bottom {
        margin-bottom: 10px;
    }

    th, td {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    #tblShipTo th {
        text-align: center;
        vertical-align: middle;
    }

    #tblShipTo td {
        vertical-align: middle;
        cursor: pointer;
    }

    .color-col {
        background-color: #C2EEFA;
    }

    .success-input {
        border-color: #00a65a;
    }

    .error-input {
        border-color: #dd4b39;
    }

    .fix-chk-mg {
        margin-top: 22px;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        color: #dd4b39;
    }

    .color-col-1 {
        background-color: #99ccff;
    }

    .color-col-2 {
        background-color: #ffcc99;
    }

    .color-col-3 {
        background-color: #07AD46;
    }

    .color-col-4 {
        background-color: #F0D10D;
    }

    .color-col-5 {
        background-color: #FCCFE2;
    }

    .color-col-6 {
        background-color: #cc9900;
    }

    .color-col-7 {
        background-color: #30CEF8;
    }

    .color-col-8 {
        background-color: #99d6ff;
    }

    .color-col-9 {
        background-color: #a3c2c2;
    }

    .color-col-10 {
        background-color: #ffffcc;
    }

    .color-col-11 {
        background-color: #DEB966;
    }

    .color-col-12 {
        background-color: #45B9F7;
    }

    .color-col-13 {
        background-color: #ff6699;
    }

    .color-col-14 {
        background-color: #739900;
    }

    .color-col-15 {
        background-color: #85E306;
    }

    .color-col-16 {
        background-color: #F0D10D;
    }
</style>
<!-- angular js -->
<script src="/Scripts/Controller/ShipToController.js"></script>
<input type="hidden" value="@userDto.UserId" id="userIdSession" />
<div class="ng-cloak" ng-controller="ShipToController">
    <section class="content-header">
        <h1>
            Ship to licenses
            <small>Control panel</small>
        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i>Home</a></li>
            <li class="active">Ship to licenses</li>
        </ol>
    </section>
    <section class="content">
        <!-- CDI -->
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title">Search</h3>
                <div class="box-tools pull-right">
                    @if (userDto != null && (userDto.Team.Equals("CDI") || userDto.RoleId.Equals("ADMIN")))
                    {
                        <a href="@Url.Action("ShipToSummary", "DashboardCDI")" class="btn btn-link">Dashboard</a>
                    }
                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                    <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
                </div>
            </div>
            <!-- /.box-header -->
            <div class="box-body">
                <form ng-submit="SearchShipTo()" name="formSearch" method="get">
                    <div class="col-md-12">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="text-blue">Sold to</label>
                                <input type="text" class="form-control" id="txtCustCode" ng-model="SearchParam.CustCode" ng-change="SetPaging()" />
                            </div>
                        </div>
                        <!-- DATE CONTROL -->
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="text-green">Ship to</label>
                                <input type="text" class="form-control" id="txtShipTo" ng-model="SearchParam.ShipTo" />
                            </div>
                        </div>
                        @if (userDto != null && (userDto.Team.Equals("CDI") || userDto.RoleId.Equals("ADMIN")))
                        {
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Update By</label>
                                <select class="form-control select2" style="width:100%"
                                        data-placeholder="Select a user"
                                        ng-model="SearchParam.UserId">
                                    @foreach (var user in ViewBag.UserTeamCDI)
                                    {
                                        <option value="@user.UserId">@user.Fullname</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>From</label>
                                <div class="input-group date">
                                    <div class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </div>
                                    <input type="text" class="form-control dateControl" ng-model="SearchParam.UpdateDateFrom"
                                           data-format="dd-mm-yyyy" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>To</label>
                                <div class="input-group date">
                                    <div class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </div>
                                    <input type="text" class="form-control dateControl" ng-model="SearchParam.UpdateDateTo"
                                           data-format="dd-mm-yyyy" />
                                </div>
                            </div>
                        </div> 
                    }
                    </div>
                    <div class="col-md-12">                        
                        <div class="col-md-2 pull-left">
                            <div class="form-group">
                                <button type="submit" class="btn btn-block btn-primary btn-sm" id="btnSearch">Search</button>
                            </div>
                        </div>
                        <div class="col-md-2 pull-left">
                            <div class="form-group">
                                <button type="button" class="btn btn-block btn-warning btn-sm" ng-click="resetForm()">Clear</button>
                            </div>
                        </div>
                        @if (userDto != null && (userDto.Team.Equals("CDI") || userDto.RoleId.Equals("ADMIN")))
                        {
                        <div class="col-md-2 pull-right">
                            <div class="form-group">
                                <a href="@Url.Action("Index", "CDIManagement")" class="btn btn-block btn-primary btn-sm">Sold to</a>
                            </div>
                        </div>
                        <div class="col-md-2 pull-right">
                            <div class="form-group">
                                <button type="button" class="btn btn-block btn-success btn-sm" id="btnExport" ng-click="ExportShipTo()">
                                    <i class="fa fa-file-excel-o"></i> Export
                                </button>
                            </div>
                        </div>
                        }
                    </div>
                </form>
                <div class="col-md-12">
                    <div class="col-md-6">
                        <div class="form-group">
                            <h5>
                                <label>
                                    <span class="label label-info"><b>{{totalItems}}</b></span>&nbsp;&nbsp;row(s)
                                </label>
                            </h5>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group pull-right">
                            <simple-pagination current-page="settings.currentPage"
                                               offset="settings.offset"
                                               page-limit="settings.pageLimit"
                                               page-limits="settings.pageLimits"
                                               on-update="callback()"
                                               total="ShipToArr.length"></simple-pagination>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title">Ship To List</h3>

                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                    <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
                </div>
            </div>
            <div class="box-body">
                <div class="col-md-12 table-responsive no-padding">
                    <table id="tblShipTo" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th rowspan="2">Action</th>
                                @if (userDto != null && (userDto.Team.Equals("CDI") || userDto.RoleId.Equals("ADMIN")))
                                {
                                    <th rowspan="2" class="color-col-1">Update By</th>
                                    <th rowspan="2" class="color-col-1">Update date</th>
                                }
                                <th rowspan="2" class="color-col-1">Ship to Code</th>
                                <th rowspan="2" class="color-col-1">Ship to Name</th>
                                <th rowspan="2" class="color-col-4">Sold To</th>
                                <th colspan="3" class="color-col-2">GPP</th>
                                <th colspan="3" class="color-col-2">GDP</th>
                                <th colspan="3" class="color-col-3">GSP</th>
                                <th rowspan="2" class="color-col-4">TaxCode</th>
                                <th colspan="5" class="color-col-9">GPKD</th>
                                <th rowspan="2" class="color-col-9">Công bố <br />đủ điều kiện <br />mua bán <br />TTBYT (COE)</th>
                                <th colspan="3" class="color-col-7">GCN ĐĐKKDD</th>
                                <th colspan="5" class="color-col-8">Phạm vi <br />kinh doanh</th>
                                <th colspan="5" class="color-col-5">Đủ điều kiện<br /> xuất bán</th>
                                <th rowspan="2" class="color-col-16">Is Manual</th>
                                <th colspan="3" class="color-col-11">Giấy phép <br />hoạt động KCB</th>
                                <th rowspan="2" class="color-col-12">Danh mục <br />kỹ thuật <br />có tiêm Botox | Xeomin<br />(Botulinum)</th>
                                <th rowspan="2" class="color-col-12">Đủ điều kiện <br />mua <br /> Botox | Xeomin<br />(Botulinum)</th>
                                <th colspan="3" class="color-col-14">GCN <br />đủ điều kiện<br /> tiêm chủng</th>
                                <th rowspan="2" class="color-col-1">Remark</th>
                                <th rowspan="2" class="color-col-1">Address</th>
                                <th rowspan="2" class="color-col-1">District</th>
                                <th rowspan="2" class="color-col-1">ZTerm</th>
                                <th rowspan="2" class="color-col-1">Province</th>
                                <th rowspan="2" class="color-col-1">Region</th>
                                <th rowspan="2" class="color-col-1">Channel</th>
                                <th rowspan="2" class="color-col-1">Tel</th>
                                <th rowspan="2" class="color-col-1">CGrpCode</th>
                                <th rowspan="2" class="color-col-1">CGrpName</th>
                                <th rowspan="2" class="color-col-15">Status Licenses</th>
                                <th rowspan="2" class="color-col-16">License type missing</th>
                                <th rowspan="2">Action</th>
                            </tr>
                            <tr>
                                <!-- GPP -->
                                <th class="color-col-2">From</th>
                                <th class="color-col-2">To</th>
                                <th class="color-col-2">Remaining Days</th>
                                <!-- GDP -->
                                <th class="color-col-2">From</th>
                                <th class="color-col-2">To</th>
                                <th class="color-col-2">Remaining Days</th>
                                <!-- GSP -->
                                <th class="color-col-3">From</th>
                                <th class="color-col-3">To</th>
                                <th class="color-col-3">Remaining Days</th>
                                <!-- GPKD -->
                                <th class="color-col-9">GPKD</th>
                                <th class="color-col-9">Ngành nghề <br />kinh doanh <br />có mua bán TTBYT</th>
                                <th class="color-col-9">CMND</th>
                                <th class="color-col-9">Số GPKD</th>
                                <th class="color-col-9">Người đại diện</th>
                                <!-- GCN DDKKDD -->
                                <th class="color-col-7">From</th>
                                <th class="color-col-7">To</th>
                                <th class="color-col-7">Remaining Days</th>
                                <!-- Phạm vi kinh doanh -->
                                <th class="color-col-8">Thuốc dạng <br />phối hợp <br />có chứa dược chất<br /> gây nghiện</th>
                                <th class="color-col-8">Thuốc độc, <br />nguyên liệu độc <br />làm thuốc</th>
                                <th class="color-col-8">Thuốc dược chất<br /> thuộc danh mục <br />bị cấm sử dụng</th>
                                <th class="color-col-8">Sinh phẩm</th>
                                <th class="color-col-8">Vaccin</th>
                                <!-- Đủ điều kiện xuất bán -->
                                <th class="color-col-5">Thuốc dạng <br />phối hợp <br />có chứa dược <br />chất gây nghiện</th>
                                <th class="color-col-5">Thuốc độc, <br />nguyên liệu độc <br />làm thuốc</th>
                                <th class="color-col-5">Thuốc dược chất <br />thuộc danh mục <br />bị cấm sử dụng</th>
                                <th class="color-col-5">Sinh phẩm</th>
                                <th class="color-col-5">Vaccin</th>
                                <!-- GP hoạt động khám chữa bệnh -->
                                <th class="color-col-11">From</th>
                                <th class="color-col-11">To</th>
                                <th class="color-col-11">Remaining Days</th>
                                <!-- GCN Đủ điều kiện tiêm chủng -->
                                <th class="color-col-14">From</th>
                                <th class="color-col-14">To</th>
                                <th class="color-col-14">Remaining Days</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in filterData = (ShipToArr | filter : {CustCode: SearchParam.CustCode} | limitTo:settings.pageLimit:settings.offset)"
                                data-toggle="tooltip" title="{{item.ShipTo}} | {{item.CustName}} | {{item.TaxCode}} | {{item.CGrpCode}}">

                                <td>
                                    @if (userDto != null && (userDto.Team.Equals("CDI") || userDto.RoleId.Equals("ADMIN")))
                                    {
                                        <span>
                                            <button type="button" title="Update" ng-click="GetDetailLicenseShipTo(item)" class="btn btn-primary btn-sm"
                                                    data-toggle="modal">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                        </span>

                                    }
                                    <span>
                                        <button type="button" title="View Detail" ng-click="ViewShipToInfo(item)" class="btn btn-info btn-sm"
                                                data-toggle="modal" data-target="#modalShipToLicenses">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                    </span>
                                    
                                </td>
                                @if (userDto != null && (userDto.Team.Equals("CDI") || userDto.RoleId.Equals("ADMIN")))
                                {
                                    <td>{{item.UserId}}</td>
                                    <td>{{item.UpdateDate}}</td>
                                }
                                <td>{{item.ShipTo}}</td>
                                <td>{{item.CustName}}</td>
                                <td class="color-col-4">{{item.CustCode}}</td>
                                <!-- GPP -->
                                <td class="color-col-2">{{item.GPPFromDate}}</td>
                                <td class="color-col-2">{{item.GPPToDate}}</td>
                                <td class="text-center color-col-2">
                                    <label ng-if="item.GPPRemainingDays == null && item.GPPFromDate != null">
                                        <span class="label label-success"><b>∞</b></span>
                                    </label>
                                    <label ng-if="item.GPPRemainingDays > 90">
                                        <span class="label label-success"><b>{{item.GPPRemainingDays}}</b></span>
                                    </label>
                                    <label ng-if="item.GPPRemainingDays > 0 && item.GPPRemainingDays < 90">
                                        <span class="label label-warning">
                                            <b>{{status.commingexpire}}</b>
                                        </span>&nbsp;
                                        <span class="label label-warning"><b>{{item.GPPRemainingDays}}</b></span>
                                    </label>
                                    <label ng-if="item.GPPRemainingDays != null && item.GPPRemainingDays <= 0">
                                        <span class="label label-danger"><b>{{status.expired}}</b></span>
                                    </label>
                                </td>
                                <!-- GDP -->
                                <td class="color-col-2">
                                    {{item.GDPFromDate}}
                                </td>
                                <td class="color-col-2">
                                    {{item.GDPToDate}}
                                </td>
                                <td class="text-center color-col-2">
                                    <label ng-if="item.GDPRemainingDays == null && item.GDPFromDate != null">
                                        <span class="label label-success"><b>∞</b></span>
                                    </label>
                                    <label ng-if="item.GDPRemainingDays > 90">
                                        <span class="label label-success"><b>{{item.GDPRemainingDays}}</b></span>
                                    </label>
                                    <label ng-if="item.GDPRemainingDays > 0 && item.GDPRemainingDays < 90">
                                        <span class="label label-warning">
                                            <b>{{status.commingexpire}}</b>
                                        </span>&nbsp;
                                        <span class="label label-warning"><b>{{item.GDPRemainingDays}}</b></span>
                                    </label>
                                    <label ng-if="item.GDPRemainingDays != null && item.GDPRemainingDays <= 0">
                                        <span class="label label-danger"><b>{{status.expired}}</b></span>
                                    </label>
                                </td>
                                <!-- GSP -->
                                <td class="color-col-3">
                                    {{item.GSPFromDate}}
                                </td>
                                <td class="color-col-3">
                                    {{item.GSPToDate}}
                                </td>
                                <td class="text-center color-col-3">
                                    <label ng-if="item.GSPRemainingDays == null && item.GSPFromDate != null">
                                        <span class="label label-success"><b>∞</b></span>
                                    </label>
                                    <label ng-if="item.GSPRemainingDays > 90">
                                        <span class="label label-success"><b>{{item.GSPRemainingDays}}</b></span>
                                    </label>
                                    <label ng-if="item.GSPRemainingDays > 0 && item.GSPRemainingDays < 90">
                                        <span class="label label-warning">
                                            <b>{{status.commingexpire}}</b>
                                        </span>&nbsp;
                                        <span class="label label-warning"><b>{{item.GSPRemainingDays}}</b></span>
                                    </label>
                                    <label ng-if="item.GSPRemainingDays != null && item.GSPRemainingDays <= 0">
                                        <span class="label label-danger"><b>{{status.expired}}</b></span>
                                    </label>
                                </td>
                                <td class="color-col-4">
                                    {{item.TaxCode}}
                                </td>
                                <!-- GPKD -->
                                <td class="text-center color-col-9">
                                    <small class="label text-center" ng-class="item.GPKD == true ? 'bg-green' : ''">
                                        {{item.GPKD == true ? 'X' : ''}}
                                    </small>
                                </td>
                                <!-- Ngành nghề kinh doanh có mua bán TTBYT YES/NO -->
                                <td class="text-center color-col-9">
                                    <small class="label text-center" ng-class="item.NNKDMBTTBYT == true ? 'bg-green' : 'bg-red'">
                                        {{item.NNKDMBTTBYT == true ? 'YES' : 'NO'}}
                                    </small>
                                </td>
                                <td class="color-col-9">{{item.CMND}}</td><!-- CMND -->
                                <td class="color-col-9">{{item.GPKDNumber}}</td><!-- Số GPKD -->
                                <td class="color-col-9">{{item.GPKDName}}</td> <!-- Người đại diện -->
                                <!-- Công bố đủ điều kiện mua bán TTBYT (COE)-->
                                <td class="color-col-9 text-center">
                                    <small class="label" ng-class="item.IsCOETTBYT == true ? 'bg-green' : ''">
                                        {{item.IsCOETTBYT == true ? 'X' : ''}}
                                    </small>
                                </td>
                                <!-- Giấy chứng nhận đủ điều kiện kinh doanh dược -->
                                <td class="color-col-7">{{item.GCNDDKKDDFromDate}}</td>
                                <td class="color-col-7">{{item.GCNDDKKDDToDate}}</td>
                                <td class="text-center color-col-7">
                                    <label ng-if="item.GCNDDKKDDRemainingDays == null && item.GCNDDKKDDFromDate != null">
                                        <span class="label label-success"><b>∞</b></span>
                                    </label>
                                    <label ng-if="item.GCNDDKKDDRemainingDays > 90">
                                        <span class="label label-success"><b>{{item.GCNDDKKDDRemainingDays}}</b></span>
                                    </label>
                                    <label ng-if="item.GCNDDKKDDRemainingDays > 0 && item.GCNDDKKDDRemainingDays < 90">
                                        <span class="label label-warning">
                                            <b>{{status.commingexpire}}</b>
                                        </span>&nbsp;
                                        <span class="label label-warning"><b>{{item.GCNDDKKDDRemainingDays}}</b></span>
                                    </label>
                                    <label ng-if="item.GCNDDKKDDRemainingDays != null && item.GCNDDKKDDRemainingDays <= 0">
                                        <span class="label label-danger"><b>{{status.expired}}</b></span>
                                    </label>
                                </td>
                                <!-- Phạm vi kinh doanh -->
                                <td class="text-center color-col-8">
                                    <small class="label text-center" ng-class="item.TDPHCCDCGN == true ? 'bg-green' : 'bg-red'">
                                        {{item.TDPHCCDCGN == true ? 'YES' : 'NO'}}
                                    </small>
                                </td>
                                <td class="text-center color-col-8">
                                    <small class="label text-center" ng-class="item.TDNLDLT == true ? 'bg-green' : 'bg-red'">
                                        {{item.TDNLDLT == true ? 'YES' : 'NO'}}
                                    </small>
                                </td>
                                <td class="text-center color-col-8">
                                    <small class="label text-center" ng-class="item.TDDMCSD == true ? 'bg-green' : 'bg-red'">
                                        {{item.TDDMCSD == true ? 'YES' : 'NO'}}
                                    </small>
                                </td>
                                <td class="text-center color-col-8">
                                    <small class="label text-center" ng-class="item.SinhPham == true ? 'bg-green' : 'bg-red'">
                                        {{item.SinhPham == true ? 'YES' : 'NO'}}
                                    </small>
                                </td>
                                <td class="text-center color-col-8">
                                    <small class="label text-center" ng-class="item.Vaccin == true ? 'bg-green' : 'bg-red'">
                                        {{item.Vaccin == true ? 'YES' : 'NO'}}
                                    </small>
                                </td>
                                <!-- Đủ điều kiện xuất bán -->
                                <td class="text-center color-col-5">
                                    <small class="label text-center" ng-class="item.DDKXB_TDPHCCDCGN == true ? 'bg-green' : 'bg-red'">
                                        {{item.DDKXB_TDPHCCDCGN == true ? 'YES' : 'NO'}}
                                    </small>
                                </td>
                                <td class="text-center color-col-5">
                                    <small class="label text-center" ng-class="item.DDKXB_TDNLDLT == true ? 'bg-green' : 'bg-red'">
                                        {{item.DDKXB_TDNLDLT == true ? 'YES' : 'NO'}}
                                    </small>
                                </td>
                                <td class="text-center color-col-5">
