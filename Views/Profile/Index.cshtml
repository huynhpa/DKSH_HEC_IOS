@model DKSHApplication.DTO.FileDto

@{
    ViewBag.Title = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var userSession = (DKSHApplication.DTO.MemberShipDto)Session["USER_SESSION"];
}
<style type="text/css">
    .dateControl {
    }
</style>
<input type="hidden" id="txtId" value="@userSession.UserId" />
<input type="hidden" id="hdUserId" value="@userSession.UserName" />
<div class="ng-cloak" ng-controller="ProfileController">

    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>User Profile
      </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i>Home</a></li>
            <li class="active">User profile</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">

        <div class="row">
            <div class="col-md-3">

                <!-- Profile Image -->
                <div class="box box-primary">
                    <div class="box-body box-profile">
                        @if (userSession != null && userSession.ImagePath != null)
                        {
                            <img class="profile-user-img img-responsive img-circle"
                                 style="width: 250px !important; height: 220px !important;"
                                 ng-src="~/Images/MemberPictures/{{UserProfile.ImagePath}}" alt="{{UserProfile.ImagePath}}" />
                        }
                        else
                        {
                            <img src="~/Images/user_icon.png" alt="user icon" class="profile-user-img img-responsive img-circle"
                             style="width: 250px !important; height: 220px !important;" />
                        }
                        <h3 class="profile-username text-center">{{UserProfile.Fullname}}</h3>

                        <p class="text-muted text-center">{{UserProfile.JobTitle}}</p>

                        @*<ul class="list-group list-group-unbordered">
                            <li class="list-group-item">
                                <b>Followers</b> <a class="pull-right">1,322</a>
                            </li>
                            <li class="list-group-item">
                                <b>Following</b> <a class="pull-right">543</a>
                            </li>
                            <li class="list-group-item">
                                <b>Friends</b> <a class="pull-right">13,287</a>
                            </li>
                        </ul>

                        <a href="#" class="btn btn-primary btn-block"><b>Follow</b></a>*@
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->

                <!-- About Me Box -->
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">About Me</h3>
                    </div>
                    <!-- /.box-header -->
                    <div class="box-body">
                        <strong><i class="fa fa-book margin-r-5"></i>Education</strong>
                        <p class="text-muted">
                            {{UserProfile.Education}}             
                        </p>
                        <hr>
                        <strong><i class="fa fa-map-marker margin-r-5"></i>Location</strong>
                        <p class="text-muted">{{UserProfile.Location}}</p>
                        <hr>
                        <strong><i class="fa fa-pencil margin-r-5"></i>Skills</strong>
                        <p>
                            {{UserProfile.Skills}}
                        </p>
                        <hr>                        
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
            <div class="col-md-9">
                <div class="nav-tabs-custom">
                    <ul class="nav nav-tabs">
                        <li class="active"><a href="#settings" data-toggle="tab">Settings</a></li>
                        <li><a href="#avatar" data-toggle="tab">Avatar</a></li>
                        @*<li><a href="#timeline" data-toggle="tab">Timeline</a></li>*@
                    </ul>
                    <div class="tab-content">
                        <div class="active tab-pane" id="settings">
                            <form class="form-horizontal" name="ProfileForm" ng-submit="Save()" method="post" novalidate>
                                <input type="hidden" value=""/>
                                <div class="form-group">
                                    <label for="inputName" class="col-sm-2 control-label text-red">Full Name *</label>
                                    <div class="col-sm-10">
                                        <input type="email" class="form-control" id="Fullname" 
                                               placeholder="Full Name" maxlength="150" ng-model="UserProfile.Fullname" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="inputName" class="col-sm-2 control-label text-red">User Name *</label>
                                    <div class="col-sm-4">
                                        <input type="text" class="form-control" id="UserName" 
                                               placeholder="Name" maxlength="100" ng-model="UserProfile.UserName">
                                    </div>
                                    <label for="inputFacebook" class="col-sm-2 control-label">Facebook</label>
                                    <div class="col-sm-4">
                                        <input type="text" class="form-control" id="inputFacebook"
                                               placeholder="Facebook account" maxlength="100" ng-model="UserProfile.Facebook">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="inputEmail" class="col-sm-2 control-label text-red">Email *</label>
                                    <div class="col-sm-4">
                                        <input type="email" maxlength="150" class="form-control" id="inputEmail" 
                                               placeholder="Email" ng-model="UserProfile.Email"/>
                                    </div>
                                    <label for="inputPhone" class="col-sm-2 control-label">Phone number</label>
                                    <div class="col-sm-4">
                                        <input type="text" class="form-control" id="inputPhone" maxlength="15"
                                               placeholder="Cell phone" ng-model="UserProfile.Phone" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="inputEmail" class="col-sm-2 control-label">Password</label>
                                    <div class="col-sm-4">
                                        <input type="password" maxlength="50" class="form-control" id="inputPassword"
                                               placeholder="Password" ng-model="UserProfile.Pwd" />
                                    </div>
                                    <label for="inputEmail" class="col-sm-2 control-label">Confirm password</label>
                                    <div class="col-sm-4">
                                        <input type="password" class="form-control" id="inputConfirmPassword" maxlength="50"
                                               placeholder="Confirm password" />
                                    </div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="inputJobTitle" class="col-sm-2 control-label text-red">Team *</label>

                                    <div class="col-sm-4">                                        
                                        <select class="form-control select2" style="width: 100%;"
                                                data-placeholder="Select a team"
                                                ng-model="UserProfile.Team">
                                            <option value="MNG">Manager</option>
                                            <option value="Support">Support</option>
                                            <option value="CDI">CDI</option>
                                            <option value="MD">Medical Device</option>
                                            <option value="PM">Pharmacy</option>
                                            <option value="TM">Tele Marketing</option>
                                            <option value="TS">Tele Sale</option>
                                            <option value="OPU">OPU</option>
                                        </select>
                                    </div>   
                                    <label for="inputJoinDate" class="col-sm-2 control-label">Join date</label>
                                    <div class="col-sm-4 input-group date" style="padding :0 15px !important">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" class="form-control dateControl"
                                               data-format="dd-mm-yyyy" ng-model="UserProfile.JoinDate">
                                    </div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="inputJobTitle" class="col-sm-2 control-label text-red">Job Title *</label>
                                    <div class="col-sm-10">
                                        <input class="form-control" id="inputJobTitle"
                                                  placeholder="Job Title" ng-model="UserProfile.JobTitle"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="inputEmail" class="col-sm-2 control-label">Location</label>
                                    <div class="col-sm-10">
                                        <input type="text" class="form-control" id="Location" maxlength="200"
                                               placeholder="Location" ng-model="UserProfile.Location" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="inputEmail" class="col-sm-2 control-label">Education</label>
                                    <div class="col-sm-10">
                                        <input type="text" class="form-control" id="Education" maxlength="200"
                                               placeholder="Educations" ng-model="UserProfile.Education" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="inputExperience" class="col-sm-2 control-label">Experience</label>
                                    <div class="col-sm-10">
                                        <textarea class="form-control" id="inputExperience" 
                                                  placeholder="Experience" ng-model="UserProfile.Experience"></textarea>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="inputSkills" class="col-sm-2 control-label">Skills</label>

                                    <div class="col-sm-10">
                                        <input type="text" class="form-control" id="inputSkills" 
                                               placeholder="Skills" ng-model="UserProfile.Skills">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="inputIsManager" class="col-sm-2 control-label">Is Manager</label>
                                    <div class="col-sm-10 form-group checkbox">
                                        <label>
                                            <input type="checkbox" ng-model="UserProfile.IsManager" />
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            <span class="label label-success"><b>MANAGER</b></span>
                                        </label>
                                    </div>
                                </div>
                                
                                <div class="form-group" ng-if="UserProfile.UserId = UserId">
                                    <div class="col-sm-offset-2 col-sm-10">
                                        <button type="submit" class="btn btn-danger">Submit</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <!-- AVATAR -->
                        <div class="tab-pane" id="avatar">
                            <div class="form-horizontal">
                                @using (Html.BeginForm("UploadAvatar", "Profile", FormMethod.Post, new { @id = "uploadForm", enctype = "multipart/form-data" }))
                                {
                                @Html.AntiForgeryToken()
                                <div class="form-group">
                                    <label for="inputAvatar" class="col-sm-3 control-label text-red">Upload avatar (Only image file)</label>
                                    <div class="col-sm-7">
                                        @Html.TextBoxFor(model => model.files, "",
                                                         new
                                                         {
                                                             @class = "col-sm-10 form-control",
                                                             @id = "fileUpload",
                                                             @type = "file",
                                                             @fileinput = "file",
                                                             @filepreview = "filepreview"
                                                         })
                                    </div>
                                    <div class="col-sm-2">
                                        <button type="submit" class="btn btn-success">
                                            <i class="fa fa-cloud-upload"></i> Upload
                                        </button>
                                    </div>
                                </div>
                                }
                                <div class="form-group">
                                    <div class="col-sm-12">
                                        <img ng-src="{{filepreview}}" class="img-responsive" ng-show="filepreview" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- AVATAR -->
                    </div>
                </div>
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </section>
</div>
<script src="/Scripts/Controller/ProfileController.js"></script>
<script type="text/javascript">
    $(function () {
        'use strict'
        $('.select2').select2();

        $('.dateControl').datepicker({
            autoclose: true,
            format: 'yyyy-mm-dd',
            todayHighlight: true,
        });
    })
</script>
