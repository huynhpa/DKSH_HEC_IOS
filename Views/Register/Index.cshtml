@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div ng-cloak ng-controller="RegisterController">
    <section class="content-header">
        <h1>
            Registration
            <small>Control panel</small>
        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i>Home</a></li>
            <li class="active">Register a new membership</li>
        </ol>
    </section>
    <section class="content">
        <div class="register-box">
            <div class="register-box-body">
                <form method="post" ng-submit="Save()">
                    <div class="form-group has-feedback">
                        <input type="text" class="form-control" placeholder="User Id" required maxlength="50" ng-model="RegisterModel.UserId" />
                        <span class="glyphicon glyphicon-user form-control-feedback"></span>
                    </div>
                    <div class="form-group has-feedback">
                        <input type="text" class="form-control" placeholder="User Name" required maxlength="50" ng-model="RegisterModel.UserName" />
                        <span class="glyphicon glyphicon-user form-control-feedback"></span>
                    </div>
                    <div class="form-group has-feedback">
                        <input type="text" class="form-control" placeholder="Full name" required maxlength="100" ng-model="RegisterModel.FullName"/>
                        <span class="glyphicon glyphicon-user form-control-feedback"></span>
                    </div>
                    <div class="form-group has-feedback">
                        <input type="email" class="form-control" placeholder="Email" required maxlength="50" ng-model="RegisterModel.Email" />
                        <span class="glyphicon glyphicon-envelope form-control-feedback"></span>
                    </div>
                    <div class="form-group has-feedback">
                        <input type="password" class="form-control" placeholder="Password" required ng-model="RegisterModel.Pwd" />
                        <span class="glyphicon glyphicon-lock form-control-feedback"></span>
                    </div>
                    <div class="form-group">
                        <select class="form-control select2" required ng-model="RegisterModel.Team" style="width:100%">
                            <option value="">TEAM</option>
                            <option value="MNG">Manager</option>
                            <option value="PS">Support</option>
                            <option value="CDI">CDI</option>
                            <option value="MD">Medical Device</option>
                            <option value="PM">Pharmacy</option>
                            <option value="TM">Tele Marketing</option>
                            <option value="TS">Tele Sale</option>
                            <option value="OPU">OPU</option>
                        </select>
                        <span class="glyphicon glyphicon-user form-control-feedback"></span>
                    </div>
                    <div class="form-group">
                        <input type="text" class="form-control" maxlength="100" required ng-model="RegisterModel.JobTitle" placeholder="Job Title" />
                        <span class="glyphicon glyphicon-user form-control-feedback"></span>
                    </div>
                    <div class="form-group">
                        <div class="input-group date">
                            <div class="input-group-addon">
                                <i class="fa fa-calendar"></i>
                            </div>
                            <input type="text" placeholder="Join date" required maxlength="10"
                                   ng-model="RegisterModel.JoinDate"
                                   class="form-control pull-right dateControl"
                                   data-format="yyyy-mm-dd" />
                        </div>
                        <span class="glyphicon glyphicon-user form-control-feedback"></span>
                    </div>
                    <div class="row">
                        <div class="col-xs-12 pull-right">
                            <button type="submit" class="btn btn-primary btn-block btn-flat">Register</button>
                        </div>
                    </div>
                </form>
                <a href="@Url.Action("Index","Login")" class="text-center">I already have a membership</a>
            </div>
        </div>
    </section>
</div>
<script src="/Scripts/Controller/RegisterController.js"></script>
<script type="text/javascript">
    $(function () {
        //Date picker
        $('.dateControl').datepicker({
            autoclose: true,
            format: 'yyyy-mm-dd',
            todayHighlight: true,
        });

        $('.select2').select2();
    })
</script>

