@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var userSession = (DKSHApplication.DTO.MemberShipDto)Session["USER_SESSION"];    
}
<link rel="stylesheet" type="text/css" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.6.3/css/font-awesome.min.css">
<link href="http://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.1/summernote.css" rel="stylesheet">
<script src="/plugins/Summer-Note/summernote.js"></script>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<style type="text/css">
    .dateControl {
    }

    .monthControl {
    }
    .fix-top-22 {
        margin-top: 22px;
    }
    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        color: #dd4b39;
    }
</style>
<div ng-controller="OBSDashboardController" ng-cloak>
    <input type="hidden" value="@ViewBag.LEADER_EXTENSION" id="txtLeaderExtension" />
    <input type="hidden" value="@ViewBag.AGENT_EXTENSION" id="txtAgentExtension" />
    <section class="content-header">
        <h1>
            Dashboard
            <small>Control panel</small>
        </h1>
        <ol class="breadcrumb">
            <li><a href="#"><i class="fa fa-dashboard"></i>Home</a></li>
            <li class="active">Dashboard</li>
        </ol>
    </section>
    <section class="content">
        <div class="row">

            <div class="box box-info">
                <div class="box-header with-border">
                    <i class="fa fa-phone"></i>
                    <h3 class="box-title">SFE Performance</h3>
                </div>
                <!-- /.box-header -->
                <div class="box-body">
                    <div class="col-md-12">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>Month (mm-yyyy)</label>
                                <div class="input-group date">
                                    <div class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </div>
                                    <input type="text" class="form-control monthControl"
                                           ng-model="SearchParam.Month" data-format="mm-yyyy" />
                                </div>
                            </div>
                        </div>
                        @if (userSession != null && !userSession.EmpLevels.Equals("AGENT"))
                        {
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Sups name</label>
                                    <select class="form-control select2" style="width: 100%;"
                                            ng-model="SearchParam.LeaderExtension" ng-change="SaleRepBySup()">
                                        <option ng-repeat="item in SupsNameList" value="{{item.AgentExtension}}">{{item.AgentExtension}}-{{item.AgentName}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Salesrep</label>
                                    <select class="form-control select2" style="width: 100%;"
                                            ng-model="SearchParam.AgentExtension">
                                        <option value="">***All agent***</option>
                                        <option ng-repeat="item in SaleRepList" value="{{item.AgentExtension}}">{{item.AgentExtension}}-{{item.AgentName}}</option>
                                    </select>
                                </div>
                            </div>
                        }
                        <div class="col-md-1 fix-top-22">
                            <div class="form-group">
                                <button type="button" class="btn btn-block btn-sm bg-aqua-active"
                                        ng-click="DashboardSummary()">
                                    <i class="fa fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <h4 class="text-red">Refresh data</h4>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>Begin Date</label>
                                <div class="input-group date">
                                    <div class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </div>
                                    <input type="text" class="form-control dateControl" ng-model="SearchParam.interval_day"
                                           data-format="dd-mm-yyyy" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>End Date</label>
                                <div class="input-group date">
                                    <div class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </div>
                                    <input type="text" class="form-control dateControl" ng-model="SearchParam.interval_day_end"
                                           data-format="dd-mm-yyyy" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-1 fix-top-22">
                            <div class="form-group">
                                <button type="button" class="btn btn-block btn-sm bg-green-active"
                                        ng-click="RefreshPerformanceData()">
                                    <i class="fa fa-refresh"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 text-center">
                        <div class="form-group">
                            <div id="chart_gauge" style="width: 100%; height: 150px;"></div>
                        </div>
                    </div>

                    <div class="col-md-12 text-center">
                        <div class="form-group">
                            <div id="chart_combo" style="width: 1200px; height: 500px;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Main row -->
        <div class="row">
            <!-- Left col -->
            <section class="col-lg-12 connectedSortable">
                <!-- CAMPAIGN -->
                <div class="box box-info">
                    <div class="box-header with-border">
                        <i class="fa fa-phone"></i>
                        <h3 class="box-title">Calls performance by campaigns</h3>
                    </div>
                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="col-md-12">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Month (mm-yyyy)</label>
                                    <div class="input-group date">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" class="form-control monthControl" id="dtMonth"
                                               ng-model="SearchParam.Month" data-format="mm-yyyy" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-1">
                                <div class="form-group fix-top-22">
                                    <button type="button" class="btn btn-block btn-sm bg-aqua-active"
                                            ng-click="SummaryByCampaign()">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-1">
                                <div class="form-group fix-top-22">
                                    <button type="button" class="btn btn-block btn-sm bg-green-active"
                                            ng-click="ExportSummaryByCampaign()">
                                        <i class="fa fa-file-excel-o"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 table-responsive no-padding">
                            <table id="tblCallByCampaign" class="table table-bordered table-striped">
                                <thead>
                                    <tr class="bg-olive">
                                        <th class="text-center">Campaign</th>
                                        <th class="text-center">Success</th>
                                        <th class="text-center">Unsuccess</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in filterData = (OBSDashboardModel.SummaryByCampaign)">
                                        <td>{{item.ServiceName}}</td>
                                        <td class="text-right">{{item.Success | number}}</td>
                                        <td class="text-right">{{item.Unsuccess | number}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- AGENT -->
                <div class="box box-info">
                    <div class="box-header with-border">
                        <i class="fa fa-user"></i>
                        <h3 class="box-title">Calls performance by agents</h3>
                    </div>
                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="col-md-12">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Daily | Monthly</label>
                                    <select class="form-control select2" style="width: 100%;"
                                            data-placeholder="Select a campaign"
                                            id="ddlTypeReport"
                                            ng-model="SearchParam.TypeReport">
                                        <option ng-repeat="item in TimeRange" value="{{item.value}}">{{item.label}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Extension</label>
                                    <input type="text" class="form-control" id="txtExtension"
                                           ng-model="SearchParam.Extension" />
                                </div>
                            </div>
                            <div class="col-md-2" ng-show="SearchParam.TypeReport == 'DAILY'">
                                <div class="form-group">
                                    <label>From date</label>
                                    <div class="input-group date">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" class="form-control dateControl" ng-model="SearchParam.FromDate"
                                               data-format="dd-mm-yyyy" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2" ng-show="SearchParam.TypeReport == 'DAILY'">
                                <div class="form-group">
                                    <label>To date</label>
                                    <div class="input-group date">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" class="form-control dateControl" ng-model="SearchParam.ToDate"
                                               data-format="dd-mm-yyyy" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2" ng-show="SearchParam.TypeReport == 'MONTHLY'">
                                <div class="form-group">
                                    <label>Month (mm-yyyy)</label>
                                    <div class="input-group date">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" class="form-control monthControl" id="dtMonthAgent"
                                               ng-model="SearchParam.Month" data-format="mm-yyyy" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Campaign</label>
                                    <select class="form-control select2" style="width: 100%;" multiple
                                            data-placeholder="Select a campaign" id="ddlServiceTypeID"
                                            ng-model="SearchParam.ServiceType">
                                        <option ng-repeat="item in CampaignList" value="{{item.ID}}">{{item.ServiceName}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-1">
                                <div class="form-group">
                                    <button type="button" class="btn btn-block btn-sm bg-aqua-active"
                                            ng-click="SummaryByAgent()">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-1">
                                <div class="form-group">
                                    <button type="button" class="btn btn-block btn-sm bg-green-active"
                                            ng-click="ExportSummaryByAgent()">
                                        <i class="fa fa-file-excel-o"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 table-responsive no-padding">
                            <simple-pagination current-page="settings.currentPage"
                                               offset="settings.offset"
                                               page-limit="settings.pageLimit"
                                               page-limits="settings.pageLimits"
                                               on-update="callback()"
                                               total="OBSDashboardModel.SummaryByAgent.length"></simple-pagination>
                            <table id="tblCallByAgent" class="table table-bordered table-striped">
                                <thead>
                                    <tr class="bg-olive">
                                        <th class="text-center">FullName</th>
                                        <th class="text-center">SalemanCode</th>
                                        <th class="text-center">Campaign</th>
                                        <th class="text-center">Success</th>
                                        <th class="text-center">Unsuccess</th>
                                        <th class="text-center">Effective Call</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in filterData = (OBSDashboardModel.SummaryByAgent | filter : {AgentNumber: SearchParam.Extension}  | limitTo:settings.pageLimit:settings.offset)">
                                        <td>{{item.AgentNumber}}-{{item.FullName}}</td>
                                        <td>{{item.EmployeeID}}</td>
                                        <td>{{item.ServiceName}}</td>
                                        <td class="text-right">{{item.Success | number}}</td>
                                        <td class="text-right">{{item.Unsuccess | number}}</td>
                                        <td class="text-right">{{(item.Success / (item.Success + item.Unsuccess)) * 100 | number:2}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </section>
</div>
<!-- angular js -->
<script type="text/javascript">
    $(function () {
        $('.editor').summernote({
            height: 150,
            minHeight: null,
            maxHeight: null
        });
        $('.dateControl').datepicker({
            autoclose: true,
            format: 'dd-mm-yyyy',
            todayHighlight: true,
            orientation: 'bottom'
        });
        $('.select2').select2();
        $('.monthControl').datepicker({
            autoclose: true,
            format: 'mm-yyyy',
            viewMode: "months",
            minViewMode: "months",
            useCurrent: true,
        });
                        })
</script>
<script src="~/Scripts/DashboardDKSH/OBSDashboardController.js"></script>