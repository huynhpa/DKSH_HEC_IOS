<script type="text/javascript">
    $(function () {
        var currentDate = new Date();
        $('.dateControl').datepicker({
            autoclose: true,
            format: 'dd-mm-yyyy',
            todayHighlight: true,
        });
        $('.dateControl').datepicker('setDate', currentDate);
        $('.select2').select2();
        $('.timepicker').timepicker({
            showInputs: false,
            minuteStep: 1
        });
        $('.editor').summernote({
            height: 150,
            minHeight: null,
            maxHeight: null
        });
    });
</script>
