@{
    ViewBag.Title = "Do Campaign";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var userDto = (DKSHApplication.DTO.MemberShipDto)Session["USER_SESSION"];
}
<link rel="stylesheet" href="/plugins/timepicker/bootstrap-timepicker.min.css">
<link rel="stylesheet" type="text/css" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.6.3/css/font-awesome.min.css">
<link href="http://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.1/summernote.css" rel="stylesheet">
<script src="/plugins/Summer-Note/summernote.js"></script>
<style type="text/css">
    th, td {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    #tblPhoneNumber th, #tblCallingTime th, #tblHistory th, #tblSearchCall th, #tblFocusCampaignHistory th, #tblAbbottNutrition th {
        text-align: center;
        vertical-align: middle;
    }

    #tblPhoneNumber td, #tblCallingTime td, #tblHistory td, #tblSearchCall td, #tblFocusCampaignHistory td, #tblAbbottNutrition td {
        vertical-align: middle;
    }

    .color-col {
        background-color: #C2EEFA;
    }

    .fix-modal-body {
        overflow-y: scroll;
        max-height: 450px;
    }

    .dateControl {
    }

    .editor {
    }

    .fix-chk-mg {
        margin-top: 22px;
    }

    .tr_odd {
        background-color: #BDF4FE;
    }

    .fix-modal-body {
        overflow-y: scroll;
        max-height: 550px;
    }

    .success-input {
        border-color: #00a65a;
    }

    .error-input {
        border-color: #dd4b39;
    }

    .fix-mg-top {
        margin-top: 22px;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        color: #dd4b39;
    }
    .tr-color-blue {
        background-color: #46C1FB;
    }
    .tr-color-pink {
        background-color: #FDB9E0;
    }
    .tr-color-green {
        background-color: #8EDC45;
    }
    .pointer-hand {
        cursor: pointer;
    }
    canvas {
        max-width:100%;
        height:auto;
    }
    #mycanvas {
        width: 100%;
        height: auto;
        border: 2px solid #F20D54;
    }

    div.fullscreen {
        position: absolute;
        width: 100%;
        top: 0;
        left: 0;
    }
    .mg_bottom {
        margin-bottom: 8px !important;
    }
</style>
<div class="ng-cloak" ng-controller="DoCampaignController">
    <input type="hidden" id="UserName" ng-model="UserSession.UserName" value="@userDto.UserName" />
    <input type="hidden" id="UserId" ng-model="UserSession.UserId" value="@userDto.UserId" />
    <input type="hidden" id="IsAdmin" ng-model="UserSession.IsAdmin" value="@userDto.IsAdmin" />
    <input type="hidden" id="txtProjectID" ng-model="OBSurveyParam.ProjectID" value="@userDto.GroupID"/>
    <input type="hidden" id="hdSurveyVoteID" ng-model="hdSurveyVoteID" value="@ViewBag.SurveyVoteID" />
    <section class="content-header">
        <h1>
            SURVEY CAMPAIGN
            <small>Control panel</small>
        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i>Home</a></li>            
            <li class="active">Do the campaign</li>
        </ol>
    </section>    
    <section class="content">     
        <form id="quickcall-form" name="formQuickCall" ng-submit="QuickCall()" novalidate>
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">Quick Calling</h3>
                    <div class="box-tools pull-right">
                        <a ng-click="RefreshPage()" class="btn btn-xs btn-primary"><i class="fa fa-refresh"></i>&nbsp;Refresh</a>
                        <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <!-- /.box-header -->
                <div class="box-body">
                    <div class="col-md-12">
                        <div class="form-group">
                            <div class="alert alert-success" id="success-alert" ng-show="Message.SuccessMessage != ''">
                                @*<button type="button" class="close" data-dismiss="alert" arial-label="close">&times;</button>*@
                                <strong style="font-size:13pt;">Success! {{Message.SuccessMessage}}</strong>
                            </div>
                            <div class="alert alert-danger" id="danger-alert" ng-show="Message.ErrorMessage != ''">
                                @*<button type="button" class="close" data-dismiss="alert" arial-label="close">&times;</button>*@
                                <strong style="font-size:13pt;">Error! {{Message.ErrorMessage}}</strong>
                            </div>
                            <div class="alert alert-error" id="info-alert" ng-show="Message.InfoMessage != ''">
                                @*<button type="button" class="close" data-dismiss="alert" arial-label="close">&times;</button>*@
                                <strong style="font-size:13pt;">Info! {{Message.InfoMessage}}</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Customer code</label>
                                <input type="text" class="form-control" ng-model="OBSurveyParam.CustCode" id="txtCustomerCode" />
                            </div>
                        </div>                        
                        @*<div class="col-md-5">
                            <div class="form-group">
                                <label>Campaign</label>
                                <select class="form-control" style="width: 100%;"
                                        data-placeholder="Select a campaign"
                                        id="ddlCampaigns"                                        
                                        ng-model="OBSurveyParam.ServiceId">
                                    <option ng-repeat="item in OutboundSurveyData.CampaignList" value="{{item.ID}}">{{item.ServiceName}}</option>
                                </select>
                            </div>
                        </div>*@
                        <div class="col-md-2 fix-mg-top">
                            <div class="form-group">
                                <button type="submit" class="btn btn-block btn-sm bg-blue-active">
                                    Quick Call
                                </button>
                            </div>
                        </div>                        
                        @*<div class="col-md-2 fix-mg-top">
                            <div class="form-group checkbox">
                                <label>
                                    <input type="checkbox" ng-model="OBSurveyParam.CallPlan" />
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    <b data-toggle="tooltip">
                                        Call Plan <strong>({{OBSurveyParam.CallPlanCount}})</strong>
                                    </b>
                                </label>
                            </div>
                        </div>*@                                               
                    </div>
                </div>
            </div>
        </form>
        <form id="docampaign-form" name="formDoCampaign" novalidate method="post">
            <!-- CAMPAIGN -->            
            <div class="row">
                <!-- Customer information & Licenses status -->
                <div class="col-md-7">
                    <div class="box box-primary">
                        <div class="box-header with-border">
                            <h3 class="box-title">Customer Information &amp; Licenses status</h3>
                            <div class="box-tools pull-right">
                                <a class="btn btn-xs btn-primary" data-target="#mdZaloImage"
                                   data-toggle="modal" data-keyboard="false" data-backdrop="static"
                                   ng-show="ZaloDto.ImageCode != null && ZaloDto.ImageCode != ''">
                                    Zalo Image
                                </a>
                                
                                <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                            </div>
                        </div>
                        <div class="box-body">
                            <div class="col-md-12 table-responsive no-padding" style="height:210px;">
                                <table id="tblPhoneNumber" class="table table-bordered table-striped">
                                    <thead>
                                        <tr class="bg-aqua-active">
                                            <th>Person Name</th>
                                            <th>Phone Number</th>
                                            <th>Make Call</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="item in filterData = (PhoneNumber)" title="Click on row to make the call"
                                            ng-click="Call(item)" style="cursor:pointer;">
                                            <td>{{item.PersonName}}</td>
                                            <td class="text-info text-bold text-right">{{item.PhoneNumber}}</td>
                                            <td class="text-center pointer-hand" title="Click to make the call">
                                                <span>
                                                    <small class="label label-success">
                                                        <i class="fa fa-copy"></i>
                                                    </small>
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group has-success">
                                    <label class="text-warning">CustCode</label>
                                    <input type="text" class="form-control" ng-model="iMindCustomerInfo.code" id="txtCustCode" />
                                    <input type="hidden" id="hdAssignID" ng-model="PhoneNumberObj.AssignID"
                                           value="{{PhoneNumberObj.AssignID}}" />
                                </div>
                                
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>VNZ0 Code</label>
                                    <input type="text" class="form-control" disabled="disabled" ng-model="PhoneNumberObj.VNZ0Code" id="txtVNZ0Code" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Customer Name</label>
                                    <input type="text" class="form-control" disabled="disabled" ng-model="iMindCustomerInfo.CustName" id="txtCustName" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Contact person</label>
                                    <input type="text" class="form-control" ng-model="iMindCustomerInfo.PersonName" id="txtContactPerson" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group has-error">
                                    <label class="text-danger">Phone number</label>
                                    <input type="tel" class="form-control" ng-model="iMindCustomerInfo.phone_number" id="txtPhoneNumber" />
                                </div>
                            </div>
                            <div class="col-md-2 fix-chk-mg">
                                <div class="form-group">
                                    <button type="button" ng-click="AddContactList()" class="btn bg-green-active btn-sm btn-block">
                                        Add contact
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>SO</label>
                                    <input type="text" class="form-control" ng-model="CampaignInfoDto.SO" id="txtSO" />
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label>Address</label>
                                    <input type="text" class="form-control" ng-model="iMindCustomerInfo.addr_detail" id="txtAddress" />
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-10">
                                    <div class="form-group">
                                        <label class="text-red">Special note</label>
                                        <input type="text" class="form-control" ng-model="iMindCustomerInfo.note" id="txtSpecialNote" />
                                    </div>
                                </div>
                                <div class="col-md-2 fix-chk-mg">
                                    <div class="form-group">
                                    <button type="button" ng-click="SaveSpecialNote()" class="btn bg-green-active btn-sm btn-block">
                                        Save note
                                    </button>
                                </div>
                                </div>
                                
                            </div>
                            <!-- BEGIN LICENSE STATUS -->
                            <div class="col-md-12">
                                <h5 class="box-title text-green">STATUS LICENSES &amp; LICENSES TYPE MISSING</h5>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label ng-if="CustomerLicenses.LicensesYESNO == '2'">
                                            <span class="label label-info"><b>NO CONTROL LICENSE</b></span>
                                        </label>
                                        <label ng-if="CustomerLicenses.LicensesYESNO == '1'">
                                            <span class="label label-success"><b>FULL LICENSE</b></span>
                                        </label>
                                        <label ng-if="CustomerLicenses.LicensesYESNO == '0'">
                                            <span class="label label-warning"><b>LACK OF LICENSE</b></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-12" ng-if="CustomerLicenses.LicenseGPP != null && CustomerLicenses.LicenseGPP != ''">
                                    <div class="form-group mg_bottom">
                                        <label class="text-red">{{CustomerLicenses.LicenseGPP}}</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-12" ng-if="CustomerLicenses.LicenseGDP != null && CustomerLicenses.LicenseGDP != ''">
                                    <div class="form-group mg_bottom">
                                        <label class="text-red">{{CustomerLicenses.LicenseGDP}}</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-12" ng-if="CustomerLicenses.LicenseTaxCode != null && CustomerLicenses.LicenseTaxCode != ''">
                                    <div class="form-group mg_bottom">
                                        <label class="text-red">{{CustomerLicenses.LicenseTaxCode}}</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-12" ng-if="CustomerLicenses.LicenseGPKD != null && CustomerLicenses.LicenseGPKD != ''">
                                    <div class="form-group mg_bottom">
                                        <label class="text-red">{{CustomerLicenses.LicenseGPKD}}</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-12" ng-if="CustomerLicenses.LicenseCOETTBYT != null && CustomerLicenses.LicenseCOETTBYT != ''">
                                    <div class="form-group mg_bottom">
                                        <label class="text-red">{{CustomerLicenses.LicenseCOETTBYT}}</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-12" ng-if="CustomerLicenses.LicenseGCNDDKKDD != null && CustomerLicenses.LicenseGCNDDKKDD != ''">
                                    <div class="form-group mg_bottom">
                                        <label class="text-red">{{CustomerLicenses.LicenseGCNDDKKDD}}</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-12" ng-if="CustomerLicenses.LicenseKCB != null && CustomerLicenses.LicenseKCB != ''">
                                    <div class="form-group mg_bottom">
                                        <label class="text-red">{{CustomerLicenses.LicenseKCB}}</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-12" ng-if="CustomerLicenses.LicenseDMKTBotoxXeomin != null && CustomerLicenses.LicenseDMKTBotoxXeomin != ''">
                                    <div class="form-group mg_bottom">
                                        <label class="text-red">{{CustomerLicenses.LicenseDMKTBotoxXeomin}}</label>
                                    </div>
                                </div>
                            </div>
                            <!-- END LICENSE STATUS -->
                            <div class="col-md-12" ng-show="FocusCampaignHistoryList.length > 0">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <table id="tblFocusCampaignHistory" class="table table-bordered table-striped">
                                            <thead>
                                                <tr class="bg-aqua-active">
                                                    <th>CampaignName</th>
                                                    <th>Calldate</th>
                                                    <th>Customer feedback</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr ng-repeat="item in filterData = (FocusCampaignHistoryList)">
                                                    <td>{{item.ServiceName}}</td>
                                                    <td>{{item.SurveyDate}}</td>
                                                    <td>{{item.CustomerFeedback}}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            @*<div class="col-md-12">
                                <div class="col-md-12">
                                    <div class="form-group has-feedback">
                                        <label class="text-aqua">Focus remark</label>
                                        <input type="text" class="form-control text-aqua" id="txtFocusRemark" />
                                    </div>
                                </div>
                            </div>*@
                            <div class="col-md-12">
                                <div class="col-md-3 pull-left">
                                    <div class="form-group">
                                        <button type="button" ng-click="LimitedCustomer()" class="btn bg-aqua-active btn-sm btn-block">
                                            Next Assign <i class="fa fa-hand-o-right"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-12">
                                    <ul class="list-inline">
                                        <li ng-repeat="campaign in AllActiveCampaign" class="list-inline-item" id="tabCampaign_{{campaign.ID}}">
                                            <input type="checkbox" id="chkFocus_{{campaign.ID}}" />&nbsp;<strong class="text-aqua">{{campaign.ServiceName}}</strong>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <button type="button" ng-click="LoadScript()" class="btn bg-orange-active btn-sm btn-block">
                                            Load Script
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- End customer information -->
                <!-- Begin history call -->
                <div class="col-md-5">
                    <div class="box box-primary">
                        <div class="box-header with-border">
                            <h3 class="box-title">Call History</h3>
                            <div class="box-tools pull-right">
                                <a class="btn btn-xs btn-primary" ng-click="GetAgentByUserName()">
                                    Search Call
                                </a>
                                <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                            </div>
                        </div>
                        <div class="box-body">
                            <div class="col-md-12 table-responsive no-padding">
                                <table id="tblHistory" class="table table-bordered table-striped">
                                    <thead>
                                        <tr class="bg-aqua-active">
                                            <th>#</th>
                                            <th>Survey Date</th>
                                            <th>Project name</th>
                                            <th>Agent</th>
                                            <th>PhoneNumber</th>
                                            <th>SO</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="item in filterData = (OutboundHistory)">
                                            <td>{{$index+1}}</td>
                                            <td>{{item.SurveyDate}}</td>
                                            <td>{{item.ProjectName}}</td>
                                            <td>{{item.WindowsUser}} - {{item.FullName}}</td>
                                            <td>{{item.CustomField10}}</td>
                                            <td>{{item.SO}}</td>
                                            <td>
                                                <span ng-if="item.Name == 'Successful'">
                                                    <label class="text-green">{{item.Name}}</label>
                                                </span>
                                                <span ng-if="item.Name == 'Unsuccessful'">
                                                    <label class="text-red">{{item.Name}}</label>
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end call history -->
                <!-- Recommend product -->
                @*<div class="col-md-5">
                    <div class="box box-primary">
                        <div class="box-header with-border bg-aqua-active">
                            <h3 class="box-title">&nbsp;Abbott Nutrition</h3>
                            <div class="pull-left">
                                <a ng-click="GetDoctorCallplan()" class="btn btn-xs bg-green-active" title="Refresh callplan">
                                    <i class="fa fa-refresh"></i>
                                </a>
                            </div>
                            <div class="box-tools pull-right">
                                <button type="button" class="btn btn-box-tool" data-widget="collapse">                                    
                                        <i class="fa fa-minus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="box-body">
                            <div class="col-md-12 table-responsive no-padding">
                                <table id="tblAbbottNutrition" class="table table-bordered table-striped">
                                    <thead>
                                        <tr class="bg-aqua-active">
                                            <th>Doctor Code</th>
                                            <th>Doctor Name</th>
                                            <th>PhoneNumber</th>
                                            <th>Department</th>
                                            <th>CallDate</th>
                                            <th>Extension</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="item in filterData = (DoctorCallplanList)">
                                            <td>{{item.DoctorCode}}</td>
                                            <td>{{item.DoctorNameEN}}</td>
                                            <td>{{item.PhoneNumber}}</td>
                                            <td>{{item.Department}}</td>
                                            <td>{{item.CallDate}}</td>
                                            <td>{{item.Ext}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>*@
            </div>            
            <!-- END CAMPAIGN LIST -->
            <!-- BEGIN QUESTIONS & ANSWERS -->
            <div class="row">
                <!-- question & answer -->
                <div class="col-md-7">
                    <div class="box box-primary">
                        <div class="box-header with-border bg-aqua-active">
                            <h3 class="box-title">Questions &amp; Answers - (Project: {{ProjectDto.ProjectName}})</h3>
                            <div class="box-tools pull-right">
                                <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                            </div>
                        </div>
                        <!-- /.box-header -->
                        <div class="box-body">
                            <!-- Start alert -->
                            <div class="col-md-12">
                                <div class="form-group">
                                    <h5 class="box-title text-red"><font ng-bind-html="ProjectDto.Header | unsafe"></font></h5>
                                </div>
                            </div>
                            <!-- BEGIN LOAD SCRIPT -->
                            
                            <div class="col-md-12">
                                <div class="nav-tabs-custom">
                                    <ul class="nav nav-tabs">
                                        <li ng-repeat="camp in OutboundSurveyData.CampaignList" style="border:thin solid #46C1FB; margin:2px"
                                            ng-click="GetServiceTypeById(camp.ID)" id="tabServiceType_{{camp.ID}}">
                                            <a href="#Campaign_{{camp.ID}}" data-toggle="tab" aria-expanded="false" class="text-bold">
                                                {{camp.ServiceName}}
                                            </a>
                                        </li>
                                    </ul>
                                    <div class="col-md-12 tab-content">
                                        <div class="tab-pane" ng-repeat="tabContent in OutboundSurveyData.CampaignScriptResult"
                                             id="Campaign_{{tabContent.Campaign.ID}}">
                                            <div class="box box-primary">
                                                <div class="box-body">
                                                    <div class="col-md-12" id="SurveyScriptLoading_{{$index}}">
                                                        <div class="form-group" ng-repeat="item in tabContent.ServiceQuestionList">
                                                            <label>{{item.QuestionCode}}</label>
                                                            <font ng-bind-html="item.QuestionText | unsafe"></font>
                                                            <p ng-repeat="answer in item.AnswerList">                                                                
                                                                <!-- type check box -->
                                                                <span ng-if="answer.AnswerTypeCode == '1'">
                                                                    <input type="checkbox" id="chkAnswer_{{answer.ID}}_{{substr(answer.AnswerCode)}}_{{$index}}" />
                                                                </span>
                                                                <!-- type radion button -->
                                                                <span ng-if="answer.AnswerTypeCode == '2'">
                                                                    <input type="radio" id="rdAnswerType2_{{answer.ID}}_{{substr(answer.AnswerCode)}}_{{$index}}" name="radionType2" />
                                                                </span>
                                                                <!-- type text box -->
                                                                <span ng-if="answer.AnswerTypeCode == '3'">
                                                                    <input type="text" id="txtAnswerType3_{{answer.ID}}_{{$index}}" class="form-control" placeholder="{{answer.ContentAnswer}}" />
                                                                </span>
                                                                <!-- type radion button list -->
                                                                <span ng-if="answer.AnswerTypeCode == '4'">
                                                                    <font ng-repeat="radion in answer.RadionButtonList">
                                                                        <input type="radio" id="{{radion}}_{{answer.ID}}" name="radionType4" />
                                                                    </font>
                                                                </span>
                                                                <!-- type text box -->
                                                                <span ng-if="answer.AnswerTypeCode == '5'">
                                                                    <input type="text" id="txtAnswerType5_{{answer.ID}}_{{$index}}" class="form-control" placeholder="{{answer.ContentAnswer}}" />
                                                                </span>
                                                                <!-- Content Answer -->
