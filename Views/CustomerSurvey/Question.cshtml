@{
    ViewBag.Title = "Question";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var userSession = (DKSHApplication.DTO.UserDto)Session["USER_SESSION"];
}
<link rel="stylesheet" type="text/css" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.6.3/css/font-awesome.min.css">
<link href="http://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.1/summernote.css" rel="stylesheet">
<script src="/plugins/Summer-Note/summernote.js"></script>
<style type="text/css">
    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        color: #dd4b39;
    }

    .dateControl {
    }

    .monthControl {
    }

    th, td {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: normal;
    }

    #tblQuestionnaire th {
        text-align: center;
        vertical-align: middle;
    }

    #tblQuestionnaire td {
        vertical-align: middle;
        cursor: pointer;
    }

    .color-1 {
        background-color: #7CD8FD;
    }

    .color-2 {
        background-color: #85E306;
    }

    .color-3 {
        background-color: #F0D10D;
    }

    .questionnaire {
        background-color: #A1E1FA;
        vertical-align: middle;
    }

    .total {
        background-color: #ED3309;
        color: white;
    }
</style>
<div class="ng-cloak" ng-controller="CustomerSurveyController">
    <section class="content-header">
        <h1>
            QUESTIONNAIRE
            <small>Control panel</small>
        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i>Home</a></li>
            <li class="active">Pharmacy</li>
        </ol>
    </section>
    <section class="content">
        <!-- Customer information -->
        <div class="box box-success">
            <div class="box-header with-border">
                <h3 class="box-title">Questionnaire</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                </div>
            </div>
            <div class="box-body">
                <div class="col-md-12">
                    <div class="col-md-2 pull-left">
                        <div class="form-group">
                            <a href="@Url.Action("Index", "CustomerSurvey")" class="btn btn-primary btn-block">
                                Customer Survey
                            </a>
                        </div>
                    </div>
                    <div class="col-md-2 pull-right">
                        <div class="form-group">
                            <button class="btn btn-success" type="button" ng-click="CustomerSurveyReport()">
                                <i class="fa fa-file-excel-o"></i> Report
                            </button>
                        </div>
                    </div>
                    <div class="col-md-2 pull-right">
                        <div class="form-group">
                            <button class="btn btn-warning" type="button"
                                    data-toggle="modal" data-backdrop="static"
                                    data-target="#mdQuestion" ng-click="ClearModel()">
                                New Questionnaire
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <table id="tblQuestionnaire" class="table table-bordered">
                        <thead>
                            <tr>
                                <th colspan="2">
                                    Bảng câu hỏi<br />
                                    <label class="text-green">Questionnaire</label>
                                </th>
                                <th>
                                    Thang điểm chuẩn<br />
                                    <label class="text-green">Rank mark</label>
                                </th>
                                <th>
                                    Action
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Trung tâm chăm sóc khách hàng / Customer Call Center -->
                            <tr class="questionnaire">
                                <td colspan="3">
                                    <label>Trung tâm chăm sóc khách hàng / </label>
                                    <label class="text-green">Customer Call Center</label>
                                </td>
                                <td class="text-center"></td>
                            </tr>
                            <tr ng-repeat="item in filterData = (Questionnaire.CustomerCareCenter)">
                                <td style="white-space:nowrap !important">{{item.QuestionChildId}}</td>
                                <td>
                                    {{item.QuestionVN}}<br />
                                    <label class="text-aqua">{{item.QuestionEN}}</label>
                                </td>
                                <td class="text-center">{{item.RankMark}}</td>
                                <td style="white-space:nowrap !important;">
                                    <span>
                                        <button type="button" class="btn btn-primary" data-toggle="modal" data-backdrop="static"
                                                ng-click="GetQuestionDetail(item)" data-target="#mdQuestion">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                    </span>
                                    <span>
                                        <button type="button" class="btn btn-pinterest" data-backdrop="static"
                                                data-toggle="modal" ng-click="DeleteQuestion(item)">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </span>
                                </td>
                            </tr>
                            <!-- Giao Hàng / Transportation -->
                            @*<tr class="questionnaire">
                                <td colspan="3">
                                    <label>Giao Hàng / </label>
                                    <label class="text-green">Transportation</label>
                                </td>
                                <td class="text-center"></td>
                            </tr>
                            <tr ng-repeat="item in filterData = (Questionnaire.Transportation)">
                                <td style="white-space:nowrap !important">{{item.QuestionChildId}}</td>
                                <td>
                                    {{item.QuestionVN}}<br />
                                    <label class="text-aqua">{{item.QuestionEN}}</label>
                                </td>
                                <td class="text-center">{{item.RankMark}}</td>
                                <td style="white-space:nowrap !important;">
                                    <span>
                                        <button type="button" class="btn btn-primary" data-toggle="modal" data-backdrop="static"
                                                ng-click="GetQuestionDetail(item)" data-target="#mdQuestion">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                    </span>
                                    <span>
                                        <button type="button" class="btn btn-pinterest" data-backdrop="static"
                                                data-toggle="modal" ng-click="DeleteQuestion(item)">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </span>
                                </td>
                            </tr>*@
                            <!-- Công Nợ / Credit (apply for credit customer) -->
                            @*<tr class="questionnaire">
                                <td colspan="3">
                                    <label>Công Nợ / </label>
                                    <label class="text-green">Credit (apply for credit customer)</label>
                                </td>
                                <td class="text-center"></td>
                            </tr>
                            <tr ng-repeat="item in filterData = (Questionnaire.Credit)">
                                <td style="white-space:nowrap !important">{{item.QuestionChildId}}</td>
                                <td>
                                    {{item.QuestionVN}}<br />
                                    <label class="text-aqua">{{item.QuestionEN}}</label>
                                </td>
                                <td class="text-center">{{item.RankMark}}</td>
                                <td style="white-space:nowrap !important;">
                                    <span>
                                        <button type="button" class="btn btn-primary" data-toggle="modal" data-backdrop="static"
                                                ng-click="GetQuestionDetail(item)" data-target="#mdQuestion">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                    </span>
                                    <span>
                                        <button type="button" class="btn btn-pinterest" data-backdrop="static"
                                                data-toggle="modal" ng-click="DeleteQuestion(item)">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </span>
                                </td>
                            </tr>*@
                            <!-- Trình Dược Viên / Sales Rep -->
                            @*<tr class="questionnaire">
                                <td colspan="3">
                                    <label>Trình Dược Viên / </label>
                                    <label class="text-green">Sales Rep</label>
                                </td>
                                <td class="text-center"></td>
                            </tr>
                            <tr ng-repeat="item in filterData = (Questionnaire.SalesRep)">
                                <td style="white-space:nowrap !important">{{item.QuestionChildId}}</td>
                                <td>
                                    {{item.QuestionVN}}<br />
                                    <label class="text-aqua">{{item.QuestionEN}}</label>
                                </td>
                                <td class="text-center">{{item.RankMark}}</td>
                                <td style="white-space:nowrap !important;">
                                    <span>
                                        <button type="button" class="btn btn-primary" data-toggle="modal" data-backdrop="static"
                                                ng-click="GetQuestionDetail(item)" data-target="#mdQuestion">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                    </span>
                                    <span>
                                        <button type="button" class="btn btn-pinterest" data-backdrop="static"
                                                data-toggle="modal" ng-click="DeleteQuestion(item)">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </span>
                                </td>
                            </tr>*@
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div id="mdQuestion" class="modal fade" role="dialog">
            <div class="modal-dialog" style="width: 70%; margin: 30px auto;">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title text-info">New &amp; Update Questionnaire</h4>
                    </div>
                    <form name="QuestionnaireForm" method="post" ng-submit="SubmitQuestion()">
                        <div class="modal-body">
                            <div class="box box-success">
                                <div class="box-header with-border">
                                    <h3 class="box-title"></h3>
                                    <div class="box-tools pull-right">
                                        <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                                    </div>
                                </div>
                                <div class="box-body">
                                    <div class="col-md-12">
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label>Question title</label>
                                                <select class="form-control select2" style="width: 100%;" id="ddlQuestionTitle"
                                                        ng-model="QuestionnaireTitleId" ng-disabled="isUpdate">
                                                    <option ng-repeat="obj in QuestionTitle" value="{{obj.QuestionnaireTitleId}}">{{obj.DescVN}} / {{obj.DescEN}}</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Question Parent.</label>
                                                <input type="text" class="form-control"  ng-disabled="isUpdate"
                                                       ng-model="CustomerSurveyModel.QuestionParentId" id="txtQuestionParent" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Question Child</label>
                                                <input type="text" class="form-control"  ng-disabled="isUpdate"
                                                       ng-model="CustomerSurveyModel.QuestionChildId" id="txtQuestionChild" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <label>Question VN</label>
                                                <input type="text" class="form-control" ng-model="CustomerSurveyModel.QuestionVN" id="txtQuestionVN" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <label>Question EN</label>
                                                <input type="text" class="form-control" ng-model="CustomerSurveyModel.QuestionEN" id="txtQuestionEN" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Rank mark</label>
                                                <input type="number" min="0" class="form-control" ng-model="CustomerSurveyModel.RankMark" id="txtRankMark" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-success">Submit</button>
                                    <button type="button" class="btn btn-pinterest" data-dismiss="modal">Cancel</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</div>
<script src="/Scripts/Controller/CustomerSurveyController.js"></script>
<script type="text/javascript">
    $(function () {
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        //Date picker
        $('.dateControl').datepicker({
            autoclose: true,
            format: 'dd-mm-yyyy',
            todayHighlight: true
        });
        $('.dateControl').datepicker('setDate', today);
        $('.editor').summernote({
            height: 150,
            minHeight: null,
            maxHeight: null
        });
        $('.select2').select2();
    })
</script>



