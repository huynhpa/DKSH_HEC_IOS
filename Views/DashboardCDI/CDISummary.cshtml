<script type="text/javascript">
    $(function () {
        'use strict'
        $('[data-mask]').inputmask();
        $('.select2').select2();

        $('.dateControl').datepicker({
            autoclose: true,
            format: 'dd-mm-yyyy',
            todayHighlight: true,
        });

        $('.monthControl').datepicker({
            autoclose: true,
            format: 'mm-yyyy',
            viewMode: "months",
            minViewMode: "months",
            useCurrent: true,
        });

        $('.yearControl').datepicker({
            autoclose: true,
            format: 'yyyy',
            viewMode: "years",
