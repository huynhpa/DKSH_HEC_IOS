                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>From (mm-yyyy)</label>
                            <div class="input-group date">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input type="text" class="form-control monthControl" id="dtFromMonth" ng-model="CDIDashboardModel.FromMonth"
                                        data-format="mm-yyyy" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>To (mm-yyyy)</label>
                            <div class="input-group date">
                                <div class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <input type="text" class="form-control monthControl" id="dtToMonth" ng-model="CDIDashboardModel.ToMonth"
                                        data-format="mm-yyyy" />
