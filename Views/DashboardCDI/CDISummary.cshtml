@{
    ViewBag.Title = "CDI Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var userSession = (DKSHApplication.DTO.UserDto)Session["USER_SESSION"];
    var CERTIFICATION_INVALID = ViewBag.CERTIFICATION_INVALID;
}
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<style type="text/css">
    .bg-viber {
        background-color: #AF09A1;
        color: #FFFFFF;
    }
    #tblLicensesExpired td, #tblLicensesLack td {
        vertical-align: middle;
        cursor: pointer;
        font-weight: bold;
    }
    .bg-title-green {
        background-color: #109618;
        color: #FFFFFF;
    }
    .bg-title-red {
        background-color: #DC3912;
        color: #FFFFFF;
    }
    .text-white {
        color: #FFFFFF;
    }
    .pharmacy {
        color: rgb(51, 102, 204);
    }
    .diagnostics {
        color: rgb(220, 57, 18);
    }
    .others {
        color: rgb(255, 153, 0);
    }
    .hospitaldrClinic {
        color: rgb(16, 150, 24);
    }
    .odd {
        background-color: #BDF4FE;
    }
    .col-total {
        background-color: #F7D52B;
    }
    .yearControl {}
    .monthControl {
    }
</style>

<div class="ng-cloak" ng-controller="CDIDashboardController">
<section class="content-header">
    <h1>CDI Dashboard   
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i>Home</a></li>
        <li class="active">CDI Summary</li>
    </ol>
</section>
<section class="content">
@if (userSession != null && (userSession.Team.Equals("CDI") || userSession.RoleId.Equals("ADMIN")))
{
<div class="row">
    <div class="col-md-1 col-sm-4 col-xs-12">
        <p><a href="@Url.Action("Index", "CDIManagement")" class="btn btn-sm btn-primary btn-block">Sold to</a></p>
    </div>
    <div class="col-md-1 col-sm-4 col-xs-12">
        <p><a href="@Url.Action("New", "CDIManagement")" class="btn btn-sm btn-success btn-block">New</a></p>
    </div>
    <div class="col-md-1 col-sm-4 col-xs-12">
        <p><a href="@Url.Action("Report", "CDIManagement")" class="btn btn-sm btn-info btn-block">Report</a></p>
    </div>
    <div class="col-md-2 col-sm-4 col-xs-12">
        <p><a href="@Url.Action("ProcessAndBackup", "CDIManagement")" class="btn btn-sm btn-warning btn-block">Process &amp; Back Up</a></p>
    </div>
    <div class="col-md-2 col-sm-4 col-xs-12">
        <p><a href="@Url.Action("ShipTo", "CDIManagement")" class="btn btn-sm btn-success btn-block"><i class="fa fa-ambulance"></i> Ship To</a></p>
    </div>
</div>
}
<div class="row">
    <div class="col-lg-3 col-xs-6">
        <div class="small-box bg-green">
            <div class="inner">
                <h3>{{LicensesSummary.TotalCustomerActive | number}}</h3>
                <p>Total customers active</p>
            </div>
            <div class="icon">
                <i class="ion ion-ios-people-outline"></i>
            </div>
            <a href="#" ng-click="Export('ALL_CUSTOMERS_ACTIVE')" class="small-box-footer"><i class="fa fa-file-excel-o"></i> Export</a>
        </div>
    </div>
    <div class="col-lg-3 col-xs-6">
        <div class="small-box bg-yellow">
            <div class="inner">
                <h3>{{LicensesSummary.TotalCustCodeLackLicense | number}}</h3>
                <p>Licenses Expired &amp; Lack</p>
            </div>
            <div class="icon">
                <i class="fa fa-certificate"></i>
            </div>
            <a href="#" ng-click="Export('ALL_CUSTOMERS_LICENSES_EXPIRED_LACK')" class="small-box-footer"><i class="fa fa-file-excel-o"></i> Export</a>
        </div>
    </div>
    <div class="col-lg-3 col-xs-6">
        <div class="small-box bg-aqua">
            <div class="inner">
                <h3>{{LicensesSummary.TotalTaxCodeValid | number}}</h3>
                <p>Tax Code Valid</p>
            </div>
            <div class="icon">
                <i class="fa fa-legal"></i>
            </div>
            <a href="#" ng-click="Export('ALL_CUSTOMERS_TAXCODE_VALID')" class="small-box-footer"><i class="fa fa-file-excel-o"></i> Export</a>
        </div>
    </div>
    <div class="col-lg-3 col-xs-6">
        <div class="small-box bg-purple">
            <div class="inner">
                <h3>{{LicensesSummary.TotalTaxCodeInValid | number}}</h3>
                <p>Tax Code Blank &amp; No Provided</p>
            </div>
            <div class="icon">
                <i class="fa fa-legal"></i>
            </div>
            <a href="#" ng-click="Export('ALL_CUSTOMERS_BLANK_NOPROVIDED')" class="small-box-footer"><i class="fa fa-file-excel-o"></i> Export</a>
        </div>
    </div>
</div>
<!-- Small boxes (Stat box) -->
<!-- BEGIN CUSTOMER BY CHANNELS GOOGLE CHART -->
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">Customers by Channels</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse">
                        <i class="fa fa-minus"></i>
                    </button>
                    <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-times"></i></button>
                </div>
            </div>
            <div class="box-body">
                <div class="row">
                    <!-- Chart area -->
                    <div class="col-md-7">
                        <div class="chart-responsive">
                            <div id="PieChartChannel" style="width: 800px; height: 500px;"></div>
                        </div>
                    </div>
                    <!-- Chart area -->
                    <div class="col-md-5">
                        <div class="box-footer no-padding">
                            <ul class="nav nav-pills nav-stacked">
                                <li>
                                    <a href="#" class="text-bold text-blue" ng-click="Export('PHARMACY_PHARMACYCOMPANY')" title="Export (xlsx)">
                                        <i class="fa fa-file-excel-o text-blue"></i> 
                                        PHARMACY &amp; PHARMACY COMPANY
                                        <span class="pull-right text-blue">
                                            {{LicensesSummary.TotalCustomerPharmacy | number}} | 
                                            {{LicensesSummary.TotalCustomerPharmacy / LicensesSummary.TotalCustomerActive*100 | number:1}} %
                                        </span>
                                    </a>
                                </li>
                                <li>
                                    <a href="#" class="text-bold text-red" ng-click="Export('DIANOSTICS_OTHER')" title="Export (xlsx)">
                                        <i class="fa fa-file-excel-o text-red"></i> 
                                        DIAGNOSTICS
                                        <span class="pull-right text-red">
                                            {{LicensesSummary.TotalCustomerDianostics | number}} | 
                                            {{LicensesSummary.TotalCustomerDianostics / LicensesSummary.TotalCustomerActive*100 | number:1}} %
                                        </span>
                                    </a>
                                </li>
                                <li>
                                    <a href="#" class="text-bold text-orange" ng-click="Export('OTHERS')" title="Export (xlsx)">
                                        <i class="fa fa-file-excel-o text-orange"></i>
                                        OTHERS
                                        <span class="pull-right text-orange">
                                            {{LicensesSummary.TotalCustomerOthers | number}} | 
                                            {{LicensesSummary.TotalCustomerOthers / LicensesSummary.TotalCustomerActive * 100 | number:1}} %
                                        </span>
                                    </a>
                                </li>
                                <li>
                                    <a href="#" ng-click="Export('HOSPITAL_CLINIC')" class="text-bold text-green" title="Export (xlsx)">
                                        <i class="fa fa-file-excel-o text-green"></i>
                                         HOSPITAL &amp; DR. CLINIC
                                        <span class="pull-right text-green">
                                            {{LicensesSummary.TotalCustomerHospitalClinic | number}} | 
                                            {{LicensesSummary.TotalCustomerHospitalClinic / LicensesSummary.TotalCustomerActive * 100 | number:1}} %
                                        </span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END CUSTOMERS BY CHANNELS GOOGLE PIE CHART -->
