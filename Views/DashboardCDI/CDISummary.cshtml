<div class="row">
    <div class="col-md-6">
        <div class="box box-danger">
            <div class="box-header with-border">
                <h3 class="box-title text-bold text-red">Licenses Expired</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse">
                        <i class="fa fa-minus"></i>
                    </button>
                    <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-times"></i></button>
                </div>
            </div>
            <!-- /.box-header -->
            <div class="box-body">
                <div class="table-responsive">
                    <table class="table table-hover no-margin" id="tblLicensesExpired">
                        <thead>
                            <tr>
                                <th class="text-bold text-red">Licenses type</th>
                                <th class="text-bold text-red">Quantity</th>
                                <th class="text-bold text-red">Percent (%)</th>
                                <th class="text-bold text-red">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>GPP</td>
                                <td>{{LicensesSummary.TotalGPPExpired | number}}</td>
                                <td class="text-green">
                                    {{LicensesSummary.TotalGPPExpired/LicensesSummary.TotalLicensesExpired * 100 | number:1}}
                                </td>
                                <td>
                                    <button type="button" title="Export (xlsx)" class="btn btn-xs btn-success" ng-click="Export('GPP_EXPIRED')">
                                        <i class="fa fa-file-excel-o"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>GDP</td>
                                <td>{{LicensesSummary.TotalGDPExpired | number}}</td>
                                <td class="text-green">
                                    {{LicensesSummary.TotalGDPExpired/LicensesSummary.TotalLicensesExpired * 100 | number:1}}
                                </td>
                                <td>
                                    <button type="button" title="Export (xlsx)" class="btn btn-xs btn-success" ng-click="Export('GDP_EXPIRED')">
                                        <i class="fa fa-file-excel-o"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>Giấy chứng nhận đủ điều kiện kinh doanh dược</td>
                                <td>{{LicensesSummary.TotalGCNDDKKDDExpired | number}}</td>
                                <td class="text-green">
                                    {{LicensesSummary.TotalGCNDDKKDDExpired/LicensesSummary.TotalLicensesExpired * 100 | number:1}}
                                </td>
                                <td>
                                    <button type="button" title="Export (xlsx)" class="btn btn-xs btn-success" ng-click="Export('GCNDDKKDD_EXPIRED')">
                                        <i class="fa fa-file-excel-o"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>Giấy phép hoạt động khám chữa bệnh</td>
                                <td>{{LicensesSummary.TotalKCBExpired | number}}</td>
                                <td class="text-green">
                                    {{LicensesSummary.TotalKCBExpired/LicensesSummary.TotalLicensesExpired * 100 | number:1}}
                                </td>
                                <td>
                                    <button type="button" title="Export (xlsx)" class="btn btn-xs btn-success" ng-click="Export('KCB_EXPIRED')">
                                        <i class="fa fa-file-excel-o"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr class="text-red">
                                <td>Total licenses expired</td>
                                <td>{{LicensesSummary.TotalLicensesExpired | number}}</td>
                                <td class="text-green">
                                    
                                </td>
