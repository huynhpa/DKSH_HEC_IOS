                        </div>
                    </div>
                    <div class="col-md-1" style="margin-top: 25px">
                        <div class="form-group">
                            <button type="button" class="btn btn-block btn-sm btn-pinterest" id="btnClear" ng-click="ClearCompare()">
                                Clear
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="col-md-2">
                        <div class="form-group">
