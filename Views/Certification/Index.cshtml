@{
    ViewBag.Title = "Certification";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var userSession = (DKSHApplication.DTO.UserDto)Session["USER_SESSION"];
}
<style type="text/css">
    th, td {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: middle;
    }
    table tr th {
        text-align: center;
    }
    #certificationList th {
        text-align: center;
        vertical-align: middle;
    }
    #certificationList td {
        vertical-align: middle;
    }
    .color-col {
        background-color: #C2EEFA;
    }
    .fix-modal-body {
        overflow-y: scroll;
        max-height: 550px;
    }
    .dateControl { }
    .fix-chk-mg {
        margin-top: 22px;
    }
    .margin-top-25 {
        margin-top: 25px;
    }
</style>

<script src="/Scripts/Controller/CertificationController.js"></script>
<div ng-cloak ng-controller="CertificationController">
<section class="content-header">
    <h1>
        Certification Management
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i>Home</a></li>
        <li class="active">Certification Management</li>
    </ol>
</section>
<section class="content">
    <div class="box box-info">
        <div class="box-header with-border">
            <h3 class="box-title">Search</h3>
            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
            </div>
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            <div class="col-md-12">
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Customer code</label>
                        <input type="text" class="form-control" id="txtCustCode" ng-model="certificateSearch.CustCode" ng-change="SetPaging()" />
                    </div>
                </div>
                <div class="col-md-2">
                    <label>Expired YES/NO</label>
                    <select class="form-control select2" style="width: 100%;" ng-model="certificateSearch.ExpiredYN">
                        <option value="0">NOT YET</option>
                        <option value="1">EXPIRED</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Certification type</label>
                        <select class="form-control select2" style="width: 100%;" ng-model="certificateSearch.Certification">
                            <option value="GCNDDKKDD">GCN ĐĐKKDD</option>
                            <option value="GPP">GPP</option>
                            <option value="GDP">GDP</option>
                            <option value="GSP">GSP</option>
                            <option value="KCB">KCB</option>
                            <option value="KSDB">GCN KSDB (Codein/Ultracet)</option>
                            <option value="COETTBYT">COE of TTBYT</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>CGrpCode</label>
                        <input type="text" class="form-control" ng-model="certificateSearch.CGrpCode" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>User Id</label>
                        <select class="form-control select2" style="width:100%"
                                data-placeholder="Select a user" 
                                ng-model="certificateSearch.UserId">
                            @foreach (var user in ViewBag.UserTeamCDI)
                            {
                                <option value="@user.UserId">@user.UserName</option>
                            }
                        </select>
                    </div>
                </div>                
            </div>
            <div class="col-md-12">
                <div class="col-md-3">
                    <div class="form-group checkbox">
                        <label>
                            <input type="checkbox" ng-model="certificateSearch.IsDelete" />
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            <span class="label label-danger"><b>IS DELETE</b></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                @*@if (userSession != null && userSession.Team.Equals("CDI"))
                {*@
                <div class="col-md-2 pull-right">
                    <div class="form-group">
                        <button type="button" class="btn btn-block btn-success" id="btnAdd"
                                data-backdrop="static" data-keyboard="false" ng-click="InsertCer()"
                                data-toggle="modal" data-target="#mdCertificate">New</button>
                    </div>
                </div>
                @*}*@
                <div class="col-md-2 pull-left">
                    <div class="form-group">
                        <button type="button" class="btn btn-block btn-primary" ng-click="searchCertification()">Search</button>
                    </div>
                </div>
                <div class="col-md-2 pull-left">
                    <div class="form-group">
                        <button type="button" class="btn btn-block btn-warning" id="btnReset" ng-click="ResetForm()">
                            Clear
                        </button>
                    </div>
                </div>                
            </div>
            <div class="col-md-12">
                <div class="col-md-3">
                    <div class="form-group">
                        <h5>
                            <label>
                                <span class="label label-info"><b>{{totalItems}}</b></span>&nbsp;&nbsp;record(s)
                            </label>
                        </h5>
                    </div>
                </div>
            </div>            
        </div>
    </div>
    <!-- Certification -->
    <div class="box box-info">
        <div class="box-header with-border">
            <h3 class="box-title text-aqua text-bold">Certification List</h3>
            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
            </div>
        </div>
        <div class="box-body">
            <div class="col-md-12 table-responsive no-padding">
                <simple-pagination current-page="settings.currentPage"
                                  offset="settings.offset"
                                  page-limit="settings.pageLimit"
                                  page-limits="settings.pageLimits"
                                  on-update="callback()"
                                  total="certificateList.length"></simple-pagination>
                <table id="certificationList" class="table table-bordered">
                    <thead>
                        <tr>
                            @*@if (userSession != null && userSession.Team.Equals("CDI"))
                            {*@
                            <th rowspan="2">Action</th>
                            @*}*@
                            <th rowspan="2">Customer Code</th>
                            <th rowspan="2">Create By</th>
                            <th rowspan="2">Create Date</th>
                            <th rowspan="2">Update By</th>
                            <th rowspan="2">Update Date</th>
                            <th rowspan="2">Sent Date</th>
                            <th rowspan="2">Is Valid Certification</th>
                            <th colspan="5" class="color-col">GCN ĐĐKKDD</th>
                            <th colspan="5">GPP</th>
                            <th colspan="5" class="color-col">GDP</th>
                            <th colspan="5">GSP</th>
                            <th colspan="5" class="color-col">Giấy phép hoạt động KCB</th>
                            <th colspan="5">Giấy chứng nhận KSDB (Codein/Ultracet)</th>
                            <th colspan="5" class="color-col">COE of TTBYT</th>
                        </tr>
                        <tr>
                            <th class="color-col">From</th>
                            <th class="color-col">To</th>
                            <th class="color-col">Status</th>
                            <th class="color-col">Remaining Days</th>
                            <th class="color-col">DDKKDD YES/NO</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Status</th>
                            <th>Remaining Days</th>
                            <th>GPP YES/NO</th>
                            <th class="color-col">From</th>
                            <th class="color-col">To</th>
                            <th class="color-col">Status</th>
                            <th class="color-col">Remaining Days</th>
                            <th class="color-col">GDP YES/NO</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Status</th>
                            <th>Remaining Days</th>
                            <th>GSP YES/NO</th>
                            <th class="color-col">From</th>
                            <th class="color-col">To</th>
                            <th class="color-col">Status</th>
                            <th class="color-col">Remaining Days</th>
                            <th class="color-col">KCB YES/NO</th>
                            <th>From</th>
                            <th>To </th>
                            <th>Status</th>
                            <th>Remaining Days</th>
                            <th>KSDB (Codein/Ultracet) YES/NO</th>
                            <th class="color-col">From</th>
                            <th class="color-col">To</th>
                            <th class="color-col">Status</th>
                            <th class="color-col">Remaining Days</th>
