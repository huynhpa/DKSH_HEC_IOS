 @{
    ViewBag.Title = "Sale Projects Manage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var userSession = (DKSHApplication.DTO.MemberShipDto)Session["USER_SESSION"];
}
<!-- Bootstrap time Picker -->
<link rel="stylesheet" href="/plugins/timepicker/bootstrap-timepicker.min.css">
<link rel="stylesheet" type="text/css" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.6.3/css/font-awesome.min.css">
<link href="http://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.1/summernote.css" rel="stylesheet">
<script src="/plugins/Summer-Note/summernote.js"></script>
<!-- bootstrap time picker -->
<script src="/plugins/timepicker/bootstrap-timepicker.min.js"></script>
<style type="text/css">
th, td {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: middle;
}

table tr th {
    text-align: center;
    color: crimson;
}

#projectList, #tblSalemanCode th {
    text-align: center;
    vertical-align: middle;
}

#projectList, #tblSalemanCode td {
    vertical-align: middle;
}

.color-col {
    background-color: #C2EEFA;
}

.fix-modal-body {
    overflow-y: scroll;
    max-height: 500px;
}
.dateControl { }
.timepicker { }
.fix-chk-mg {
    margin-top: 22px;
}
.margin-top-25 {
    margin-top: 25px;
}
.select2-container--default .select2-selection--multiple .select2-selection__choice {
    color: #dd4b39;
}
.vmiddle {
    vertical-align: middle !important;
}
.tr_odd {
    background-color: #BDF4FE;
}
.btn-style-01 {
    background-color: #F9780C;
}
</style>
<script type="text/javascript">
    $(function () {
        //Date picker
        $('.dateControl').datepicker({
            autoclose: true,
            format: 'dd-mm-yyyy',
            todayHighlight: true
        });

        $('.editor').summernote({
            height: 150,
            minHeight: null,
            maxHeight: null
        });

        $('.select2').select2();
        //Timepicker
        $('.timepicker').timepicker({
            showInputs: false,
        })
    })
</script>
<div ng-cloak ng-controller="MarketingProjectController">
<input type="hidden" value="@userSession.Team" id="txtTeam"/>
<input type="hidden" value="@userSession.UserId" id="txtUserId" />
<section class="content-header">
    <h1>
        Tele Marketing
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i>Home</a></li>
        <li class="active">Tele Marketing</li>
    </ol>
</section>
<section class="content">
    <!-- SELECT2 EXAMPLE -->
    <div class="box box-info">
        <div class="box-header with-border">
            <h3 class="box-title">Search</h3>
            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
            </div>
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            <form name="SearchForm" method="get" ng-submit="Search()">
            <div class="col-md-12">
                <!-- /.col -->
                <div class="col-md-3">
                    <!-- /.form-group -->
                    <div class="form-group">
                        <label>Project name</label>
                        <select class="form-control select2" style="width: 100%;" id="txtProjectName"
                                ng-model="SearchProject.ProjectName">                            
                            <option ng-repeat="item in ProjectNameList" value="{{item.Id}}">{{item.ProjectName}}</option>                                                        
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <!-- /.form-group -->
                    <div class="form-group">
                        <label>Campaign name</label>
                        <input type="text" class="form-control" ng-model="SearchProject.CampaignName" />
                    </div>
                </div>
                <div class="col-md-2">
                    <!-- /.form-group -->
                    <div class="form-group">
                        <label>Valid From</label>
                        <div class="input-group date">
                            <div class="input-group-addon">
                                <i class="fa fa-calendar"></i>
                            </div>
                            <input type="text" class="form-control dateControl pull-right" data-format="dd-mm-yyyy"
                                   ng-model="SearchProject.ValidFrom"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <!-- /.form-group -->
                    <div class="form-group">
                        <label>Valid To</label>
                        <div class="input-group date">
                            <div class="input-group-addon">
                                <i class="fa fa-calendar"></i>
                            </div>
                            <input type="text" class="form-control dateControl pull-right" data-format="dd-mm-yyyy"
                                   ng-model="SearchProject.ValidTo"/>
                        </div>
                    </div>
                </div>
                <!-- /.col -->
            </div>

            <!-- /.row -->
            <div class="col-md-12">
                <div class="col-sm-2 pull-left">
                    <div class="form-group">
                        <button type="submit" class="btn btn-sm btn-block btn-primary" id="btnSearch">Search</button>
                    </div>
                </div>
                <div class="col-sm-2 pull-left" ng-if="UserSession.Team == 'TM' || UserSession.UserId == 'huynhpa'">
                    <div class="form-group">
                        <button type="button" class="btn btn-block btn-info btn-sm" id="btnProcess"
                                data-backdrop="static" data-keyboard="false" ng-click="SelectProject()"
                                data-toggle="modal">
                            <i class="fa fa-cogs"></i> Process</button>
                    </div>
                </div>
                <div class="col-sm-2 pull-left">
                    <div class="form-group">
                        <button type="button" class="btn btn-block btn-pinterest btn-sm" id="btnClear" ng-click="ResetSearch()">
                            Clear
                        </button>
                    </div>
                </div>
                <div class="col-sm-2 pull-right" ng-if="UserSession.Team == 'TM' || UserSession.UserId == 'huynhpa'">
                    <div class="form-group">
                        <button type="button" class="btn btn-block btn-success btn-sm" id="btnNewProject" ng-click="GetDataGeneral(null)"
                                data-backdrop="static" data-keyboard="false"
                                data-toggle="modal" data-target="#mdNewProject">
                            New Project
                        </button>
                    </div>
                </div>
                <div class="col-sm-2 pull-right" ng-if="UserSession.Team == 'TM' || UserSession.UserId == 'huynhpa'">
                    <div class="form-group">
                        <button type="button" class="btn btn-block btn-warning btn-sm" id="btnTemplate" ng-click="DownloadTemplate()">
                            <i class="fa fa-cloud-download"></i> Template
                        </button>
                    </div>
                </div>
                <div class="col-md-2 pull-right">
                    <div class="form-group">
                        <button type="button" class="btn btn-block btn-primary btn-sm" id="btnOverView" 
                                data-backdrop="static" data-keyboard="false"
                                data-toggle="modal" data-target="#mdOverView" ng-click="ProjectOverView()">
                            <i class="fa fa-book"></i> Over View
                        </button>
                    </div>
                </div>
            </div>
            </form>
        </div>
    </div>
    <div class="box box-info">
        <div class="box-header with-border">
            <h3 class="box-title">Marketing Project List</h3>
            <div class="box-tools pull-right">
                @*<a href="#" data-backdrop="static" data-keyboard="false"
                   data-toggle="modal" data-target="#mdUpdateDataPick"
                   class="btn btn-link">Update data pick</a>*@
                <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>                
            </div>
        </div>
        <div class="box-body">
            <div class="col-md-12 table-responsive col-md-12">
                <simple-pagination current-page="settings.currentPage"
                                   offset="settings.offset"
                                   page-limit="settings.pageLimit"
                                   page-limits="settings.pageLimits"
                                   on-update="callback()"
                                   total="ProjectList.length"></simple-pagination>
                <br />
                <table id="projectList" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th class="text-center vmiddle" width="10" ng-show="UserSession.Team == 'TM' || UserSession.UserId == 'huynhpa'">
                                <input type="checkbox" ng-click="CheckAllProject()" id="allProjects" ng-model="AllProjectChecked" />
                            </th>
                            <th>Action</th>
                            <th>Picked rows</th>
                            <th>Last date process</th>
                            <th>Last create date</th>
                            <th>Project number</th>
                            <th>Project Status</th>
                            <th>Project name</th>
                            <th>Project leader</th>
                            <th>Campaign type</th>
                            <th>Campaign name</th>
                            <th>Valid from</th>
                            <th>Valid to</th>
                            <th>Min target</th>
                            <th>Max target</th>
                            <th>Outlet quantity</th>
                            <th>Outlet amount</th>
                            <th>Customers</th>
                            <th>Channels</th>
                            <th>In/Ex-Cluded Channels</th>
                            <th>Region</th>
                            <th>District</th>
                            <th>Create by</th>
                            <th>Create date</th>
                            <th>Update By</th>
                            <th>Update date</th>                            
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in filterData = (ProjectList | filter : { }
                                                                | limitTo:settings.pageLimit:settings.offset)"
                            title="{{item.ProjectName}}, from {{item.ValidFrom}} to {{item.ValidTo}}">
                            <td class="text-center vmiddle" ng-if="UserSession.Team == 'TM' || UserSession.UserId == 'huynhpa'">
                                <input type="checkbox" id="project_{{$index}}" />
                            </td>
                            <td class="text-center">
                                <span ng-if="item.MarketingDataRawCount > 0">
                                    <button type="button" title="View" class="btn btn-info btn-sm" ng-click="GetMarketingProjectByProjectNumber(item)"
                                            data-toggle="modal" data-target="#mdViewProjectDataPick">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                </span>
                                <span ng-if="item.MarketingDataRawCount > 0">
                                    <button type="button" class="btn btn-warning btn-sm" ng-click="ExportDataPick(item)" title="Download data pick">
                                        <i class="fa fa-cloud-download"></i>
                                    </button>
                                </span>
                                <span ng-if="'TM' == UserSession.Team || UserSession.UserId == 'huynhpa'">
                                    <button type="button" title="Project definition" class="btn btn-success btn-sm" ng-click="ViewProjectDefinition(item)"
                                            data-toggle="modal" data-target="#mdNewProject"
                                            data-backdrop="static" data-keyboard="false">
                                        <i class="fa fa-tags"></i>
                                    </button>
                                </span>
                                <span ng-if="'TM' == UserSession.Team || UserSession.UserId == 'huynhpa'">
                                    <button type="button" title="Update" class="btn btn-primary btn-sm" ng-click="UpdateProject(item)" 
                                            data-toggle="modal" data-target="#mdNewProject"
                                            data-backdrop="static" data-keyboard="false">
                                        <i class="fa fa-edit"></i>
                                    </button>
                                </span>
                                <span ng-if="('TM' == UserSession.Team || UserSession.UserId == 'huynhpa') && item.MarketingDataRawCount > 0">
                                    <button type="button" title="Delete data picked" class="btn btn-pinterest btn-sm" ng-click="Del(item)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </span>                                
                            </td>
                            <td>{{item.MarketingDataRawCount}}</td>
                            <td>{{item.LastDateProcess}}</td>
                            <td>{{item.LastCreateDate}}</td>
                            <td class="text-bold">{{item.ProjectNumber}}</td>
                            <td class="text-center">
                                <small class="label label-info text-center" ng-if="item.ProjectStatus == 'WAITING'">
                                    {{item.ProjectStatus}}
                                </small>
                                <small class="label label-success text-center" ng-if="item.ProjectStatus == 'INPROGRESS'">
                                    {{item.ProjectStatus}}
                                </small>
                                <small class="label label-default text-center" ng-if="item.ProjectStatus == 'CLOSED'">
                                    {{item.ProjectStatus}}
                                </small>
                            </td>
                            <td>{{item.ProjectName | uppercase}}</td>
                            <td>{{item.ProjectLeader}}</td>
                            <td>{{item.CampaignType}}</td>
                            <td>{{item.CampaignName}}</td>
                            <td>{{item.ValidFrom}}</td>
                            <td>{{item.ValidTo}}</td>
                            <td class="text-right">{{item.MinTarget | number}}</td>
                            <td class="text-right">{{item.MaxTarget | number}}</td>      
                            <td class="text-right">{{item.MinQuantity | number}}</td>
                            <td class="text-right">{{item.MinAmount | number}}</td>
                            <td>{{item.InExCludedCust}}</td>
                            <td>{{item.Channel}}</td>
                            <td>{{item.InExCludedChannel}}</td>
                            <td>{{item.InExCludedRegion}}</td>
                            <td>{{item.InExCludedDistrict}}</td>
                            <td>{{item.CreateBy}}</td>
                            <td>{{item.CreateDate}}</td>
                            <td>{{item.UpdateBy}}</td>
                            <td>{{item.UpdateDate}}</td>
                        </tr>
                    </tbody>
                </table>
                <simple-pagination current-page="settings.currentPage"
                                   offset="settings.offset"
                                   page-limit="settings.pageLimit"
                                   page-limits="settings.pageLimits"
                                   on-update="callback()"
                                   total="ProjectList.length"></simple-pagination>
            </div>
        </div>
    </div>
</section>
<!-- MODAL DIALOG -->
<div id="mdNewProject" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width: 85%; margin: 40px auto;">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" ng-click="Cancel()" data-dismiss="modal">&times;</button>
                <h4 class="modal-title text-info">Marketing Project Information</h4>
            </div>
            <form method="post" name="ProjectForm" ng-submit="Save()">
                <div class="modal-body fix-modal-body">
                    <!-- GENERAL -->
                    <div class="box box-info">
                        <div class="box-header with-border">
                            <h3 class="box-title">General</h3>
                            <div class="box-tools pull-right">
                                <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                            </div>
                        </div>
                        <div class="box-body">
                            <div class="col-md-12">
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="text-red">Project Number</label>
                                        <input type="text" class="form-control" disabled="disabled"
                                               ng-model="ProjectModel.ProjectNumber" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="text-red">Project name *</label>
                                        <input type="text" class="form-control" maxlength="50"
                                                ng-model="ProjectModel.ProjectName" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="text-red">Project Leader *</label>
                                        <input type="text" class="form-control"
                                                ng-model="ProjectModel.ProjectLeader" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="text-red">Campaign Type *</label>                                        
                                        <select class="form-control select2" style="width: 100%;"
                                                id="ddlCampaignType" ng-model="ProjectModel.CampaignType">                                            
                                            <option ng-repeat="item in CampaignTypeList" value="{{item.value}}">{{item.label}}</option>
                                        </select>                               
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="text-red">Valid from</label>
                                        <div class="input-group date">
                                            <div class="input-group-addon">
                                                <i class="fa fa-calendar"></i>
                                            </div>
                                            <input type="text" class="form-control pull-right dateControl" id="dtFromDate"                                                   
                                                   data-format="dd-mm-yyyy" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="text-red">Valid to</label>
                                        <div class="input-group date">
                                            <div class="input-group-addon">
                                                <i class="fa fa-calendar"></i>
                                            </div>
                                            <input type="text" class="form-control pull-right dateControl" id="dtToDate"                                                   
                                                   data-format="dd-mm-yyyy" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="text-red">Min Target *</label>
                                        <input type="number" class="form-control" id="txtMinAmount" ng-if="!isView"
                                               ng-model="ProjectModel.MinTarget" min="0" />
                                        <input type="text" ng-if="isView" class="form-control text-right" value="{{ProjectModel.MinTarget | number}}" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="text-red">Max Target *</label>
                                        <input type="number" class="form-control" id="txtMaxAmount" ng-if="!isView"
                                               ng-model="ProjectModel.MaxTarget" min="0" />
                                        <input type="text" ng-if="isView" class="form-control text-right" value="{{ProjectModel.MaxTarget | number}}" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Outlet Quantity</label>
                                        <input type="number" class="form-control" id="txtMinQuantity" ng-if="!isView"
                                               ng-model="ProjectModel.MinQuantity" min="0" />
                                        <input type="text" ng-if="isView" class="form-control text-right" value="{{ProjectModel.MinQuantity | number}}" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Outlet Amount</label>
                                        <input type="number" class="form-control" id="txtMinAmount" ng-if="!isView"
                                               ng-model="ProjectModel.MinAmount" min="0" />
                                        <input type="text" ng-if="isView" class="form-control text-right" value="{{ProjectModel.MinAmount | number}}" />
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-12">
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="text-red">Follow Target *</label>
                                        <select class="form-control select2" style="width: 100%;"
                                                ng-if="!isView"
                                                id="ddlPONumber" ng-model="ProjectModel.TargetFollow">
                                            <option value="QUANTITY">Quantity</option>
                                            <option value="AMOUNT">Amount</option>
                                        </select>
                                        <input type="text" ng-if="isView" ng-model="ProjectModel.TargetFollow" class="form-control"/>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Project Status</label>
                                        <select class="form-control select2" style="width: 100%;" ng-if="!isView"
                                                id="ddlPrjStatus" ng-model="ProjectModel.ProjectStatus">
                                            <option ng-repeat="item in ProjectStatusList" value="{{item.value}}">{{item.label}}</option>
                                        </select>
                                        <input type="text" ng-if="isView" ng-model="ProjectModel.ProjectStatus" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>PO Number</label>
                                        <select class="form-control select2" style="width: 100%;" ng-if="!isView"
                                                id="ddlPONumber" ng-model="ProjectModel.PONumber">
                                            <option value="ALL">All</option>
                                            <option value="OBTELE">OB & TELE</option>
                                        </select>
                                        <input type="text" ng-if="isView" ng-model="ProjectModel.PONumber" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-2 margin-top-25">
                                    <div class="form-group checkbox">
                                        <label>
                                            <input type="checkbox" checked="checked" ng-model="ProjectModel.Status" />
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            <span class="label label-success"><b>IS ACTIVE</b></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-2 margin-top-25">
                                    <div class="form-group checkbox">
                                        <label>
                                            <input type="checkbox" checked="checked" ng-model="ProjectModel.IsFOC" />
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            <span class="label label-success"><b>IS FOC</b></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                    <!-- GENERAL -->
                    <!-- Criterias -->
                    <div class="box box-info">
                        <div class="box-header with-border">
                            <h3 class="box-title">Criterias</h3>
                            <div class="box-tools pull-right">
                                <button type="button" class="btn btn-box-tool btn-sm" data-widget="collapse"><i class="fa fa-minus"></i></button>
                            </div>
                        </div>
                        <div class="box-body">
                            <div class="col-md-12">
                                <div class="col-md-9">
                                    <div class="form-group">
                                        <label>Province</label>
                                        <input class="form-control" placeholder="Please input provinces separate by commas (,)" id="txtProvince" ng-model="ProjectModel.Province" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Remark Province</label>
                                        <select class="form-control select2" style="width: 100%;" ng-if="!isView"
                                                id="ddlInExCludedProvince" ng-model="ProjectModel.InExCludedProvince">
                                            <option ng-repeat="item in InExCludedList" value="{{item.id}}">{{item.value}}</option>
                                        </select>
                                        <input type="text" class="form-control" ng-model="ProjectModel.InExCludedProvince" ng-if="isView" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-7">
                                    <div class="form-group">
                                        <label>Region</label>                                                                                
                                        <input type="text" class="form-control" id="txtRegion" ng-model="ProjectModel.Region" />                                    
                                    </div>
                                </div>
                                <div class="col-md-2 margin-top-25">
                                    <div class="form-group" ng-if="!isView">
                                        <button type="button" class="btn btn-primary btn-sm" ng-click="CheckRegion()"
                                                data-backdrop="static" data-keyboard="false"
                                                data-toggle="modal" data-target="#mdRegion">
                                            <i class="fa fa-check-square-o"></i> Select region
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Remark Region</label>
                                        <select class="form-control select2" ng-if="!isView" style="width: 100%;"
                                                id="ddlInExRegion" ng-model="ProjectModel.InExCludedRegion">
                                            <option ng-repeat="item in InExCludedList" value="{{item.id}}">{{item.value}}</option>
                                        </select>
                                        <input type="text" class="form-control" ng-model="ProjectModel.InExCludedRegion" ng-if="isView" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-9">
                                    <div class="form-group">
                                        <label>District</label>
                                        <input class="form-control" placeholder="Please input district separate by comma (,)"
                                               ng-model="ProjectModel.District"/>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Remark Dist</label>
                                        <select class="form-control select2" style="width: 100%;" ng-if="!isView"
                                                id="ddlInExRegion" ng-model="ProjectModel.InExCludedDistrict">
