<div id="mdOverView" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width: 80%; margin: 100px auto;">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title text-info">Over view</h4>
            </div>
            <form name="OverView">
                <div class="modal-body fix-modal-body">
                    <div class="box box-info">
                        <div class="box-header with-border">
                            <h3 class="box-title"></h3>
                            <div class="box-tools pull-right">
                                <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                            </div>
                        </div>
                        <div class="box-body">
                            <div class="col-md-12">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Project status</label>
                                        <select class="form-control select2" style="width: 100%;"
                                                id="ddlProjectStatus" ng-model="ProjectOverViewParam.ProjectStatus">
                                            <option ng-repeat="item in ProjectStatusList" value="{{item.value}}">{{item.label}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-2" style="margin-top: 25px;">
                                    <div class="form-group">
                                        <button type="button" class="btn btn-block btn-success btn-sm" id="btnFilter" ng-click="ProjectOverView()">
                                            Filter
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="box box-info">
                        <div class="box-header with-border">
                            <h3 class="box-title">Projects</h3>
                            <div class="box-tools pull-right">
                                <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                            </div>
                        </div>
                        <div class="box-body">
                            <div class="col-md-12 table-responsive no-padding">
                                <table id="tblOverView" class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Project Name</th>
                                            <th>Campaign type</th>
                                            <th>Min target</th>
                                            <th>Max target</th>
                                            <th>Performance archive</th>
                                            <th>Archive min target (%)</th>
                                            <th>Archive max target (%)</th>
                                            <th>Run rate min target (%)</th>
                                            <th>Run rate max target (%)</th>
                                            <th>Valid from</th>
                                            <th>Valid to</th>
                                            <th>Project Status</th>
                                            <th>Target follow</th>                                            
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="item in OverViewProject">
                                            <td>{{item.ProjectName | uppercase}}</td>
                                            <td>{{item.CampaignType}}</td>
                                            <td class="text-right">{{item.MinTarget | number}}</td>
                                            <td class="text-right">{{item.MaxTarget | number}}</td>
                                            <td class="text-right">{{item.PerformanceArchive | number : 0}}</td>
                                            <td class="text-right">
                                                <label ng-if="item.ArchiveMinTarget >= 100">
                                                    <span ng-class="item.ProjectStatus == 'CLOSED' ? 'label label-default' : 'label label-success'"><b>{{item.ArchiveMinTarget | number : 2}}</b></span>
                                                </label>
                                                <label ng-if="item.ArchiveMinTarget >= 80 && item.ArchiveMinTarget <= 99">
                                                    <span ng-class="item.ProjectStatus == 'CLOSED' ? 'label label-default' : 'label label-warning'"><b>{{item.ArchiveMinTarget | number : 2}}</b></span>
                                                </label>
                                                <label ng-if="item.ArchiveMinTarget < 80">
                                                    <span ng-class="item.ProjectStatus == 'CLOSED' ? 'label label-default' : 'label label-danger'"><b>{{item.ArchiveMinTarget | number : 2}}</b></span>
                                                </label>
                                            </td>
                                            <td class="text-right">
                                                <label ng-if="item.ArchiveMaxTarget >= 100">
                                                    <span ng-class="item.ProjectStatus == 'CLOSED' ? 'label label-default' : 'label label-success'"><b>{{item.ArchiveMaxTarget | number : 2}}</b></span>
                                                </label>
                                                <label ng-if="item.ArchiveMaxTarget >= 80 && item.ArchiveMaxTarget <= 99">
                                                    <span ng-class="item.ProjectStatus == 'CLOSED' ? 'label label-default' : 'label label-warning'"><b>{{item.ArchiveMaxTarget | number : 2}}</b></span>
                                                </label>
                                                <label ng-if="item.ArchiveMaxTarget < 80">
                                                    <span ng-class="item.ProjectStatus == 'CLOSED' ? 'label label-default' : 'label label-danger'"><b>{{item.ArchiveMaxTarget | number : 2}}</b></span>
                                                </label>
                                            </td>
                                            <td class="text-right">
                                                <label ng-if="item.RunRateMinTarget >= 100">
                                                    <span ng-class="item.ProjectStatus == 'CLOSED' ? 'label label-default' : 'label label-success'"><b>{{item.RunRateMinTarget | number : 2}}</b></span>
                                                </label>
                                                <label ng-if="item.RunRateMinTarget >= 80 && item.RunRateMinTarget <= 99">
                                                    <span ng-class="item.ProjectStatus == 'CLOSED' ? 'label label-default' : 'label label-warning'"><b>{{item.RunRateMinTarget | number : 2}}</b></span>
                                                </label>
                                                <label ng-if="item.RunRateMinTarget < 80">
                                                    <span ng-class="item.ProjectStatus == 'CLOSED' ? 'label label-default' : 'label label-danger'"><b>{{item.RunRateMinTarget | number : 2}}</b></span>
                                                </label>
                                            </td>
                                            <td class="text-right">
                                                <label ng-if="item.RunRateMaxTarget >= 100">
                                                    <span ng-class="item.ProjectStatus == 'CLOSED' ? 'label label-default' : 'label label-success'"><b>{{item.RunRateMaxTarget | number : 2}}</b></span>
                                                </label>
                                                <label ng-if="item.RunRateMaxTarget >= 80 && item.RunRateMaxTarget <= 99">
                                                    <span ng-class="item.ProjectStatus == 'CLOSED' ? 'label label-default' : 'label label-warning'"><b>{{item.RunRateMaxTarget | number : 2}}</b></span>
                                                </label>
                                                <label ng-if="item.RunRateMaxTarget < 80">
                                                    <span ng-class="item.ProjectStatus == 'CLOSED' ? 'label label-default' : 'label label-danger'"><b>{{item.RunRateMaxTarget | number : 2}}</b></span>
                                                </label>
                                            </td>
                                            <td>{{item.ValidFrom}}</td>
                                            <td>{{item.ValidTo}}</td>
                                            <td class="text-center">
                                                <small class="label label-info text-center" ng-if="item.ProjectStatus == 'WAITING'">
                                                    {{item.ProjectStatus}}
                                                </small>
                                                <small class="label label-success text-center" ng-if="item.ProjectStatus == 'INPROGRESS'">
                                                    {{item.ProjectStatus}}
                                                </small>
                                                <small class="label label-default text-center" ng-if="item.ProjectStatus == 'CLOSED'">
                                                    {{item.ProjectStatus}}
                                                </small>
                                            </td>
                                            <td>{{item.TargetFollow}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-pinterest btn-sm" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- END OVER VIEW -->
</div>
<script src="/Scripts/Controller/MarketingProjectController.js"></script>
<!-- END MODAL -->
