@{
    ViewBag.Title = "Search call";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var userDto = (DKSHApplication.DTO.MemberShipDto)Session["USER_SESSION"];
}
<style type="text/css">
    th, td {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    #tblSearchCall th {
        text-align: center;
        vertical-align: middle;
    }

    #tblSearchCall td {
        vertical-align: middle;
    }

    .color-col {
        background-color: #C2EEFA;
    }

    .fix-modal-body {
        overflow-y: scroll;
        max-height: 600px;
    }

    .dateControl {
    }

    .editor {
    }

    .fix-chk-mg {
        margin-top: 22px;
    }
    .tr_odd {
        background-color: #BDF4FE;
    }
    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        color: #0FAAE8;
    }
</style>

<!-- Bootstrap time Picker -->
<link rel="stylesheet" href="/plugins/timepicker/bootstrap-timepicker.min.css">
<script type="text/javascript">
    $(function () {
        //Date picker
        $('.dateControl').datepicker({
            autoclose: true,
            format: 'dd-mm-yyyy',
            todayHighlight: true,
            orientation: 'bottom'
        });
    })
</script>

<div class="ng-cloak" ng-controller="SearchCallController">
<input type="hidden" id="UserName" ng-model="UserSession.UserName" value="@userDto.UserName" />
<input type="hidden" id="Extension" ng-model="UserSession.Extension" value="@userDto.Extension" />
<input type="hidden" id="UserId" ng-model="UserSession.UserId" value="@userDto.UserId" />
<input type="hidden" id="contracts" ng-model="UserSession.contracts" value="@userDto.contracts" />
<input type="hidden" id="IsAdmin" ng-model="UserSession.IsAdmin" value="@userDto.IsAdmin" />
<section class="content-header">
    <h1>
        Survey History
        <small>Control panel</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i>Home</a></li>
        <li class="active">Survey History</li>
    </ol>
</section>
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="nav-tabs-custom">
                <ul class="nav nav-tabs">
                    <li class="active" ng-click="Reset()"><a href="#SearchCall"data-toggle="tab" aria-expanded="false">Calls History</a></li>
                    <li class="" ng-click="Reset()"><a href="#EffectiveCampaignHistory" data-toggle="tab" aria-expanded="false">Campaigns History</a></li>
                </ul>
                <div class="col-md-12 tab-content">
                    <!-- BEGIN SEARCH CALL FORM -->
                    <div class="tab-pane active" id="SearchCall">
                        <div class="box box-info">
                            <div class="box-header with-border">
                                <h3 class="box-title">Calls History</h3>
                                <div class="box-tools pull-right">
                                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                                    <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
                                </div>
                            </div>
                            <div class="box-body">
                                <form ng-submit="Search()" name="formSearch" method="get">
                                    <div class="col-md-12">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Customer Code</label>
                                                <input type="text" class="form-control" ng-model="SearchParam.CustomerCode"
                                                       placeholder="Customers code separate by comma (,)" ng-change="SetPaging()" />
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Contract</label>
                                                <select class="form-control" style="width: 100%;"
                                                        data-placeholder="Select report type"
                                                        ng-model="SearchParam.contracts">
                                                    <option value="VIME">VIME</option>
                                                    <option value="DKSH">DKSH</option>
                                                    <option value="GIGAMED">GIGAMED</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group has-error">
                                                <label>Campaign</label>
                                                <select class="form-control select2" style="width: 100%;" multiple
                                                        data-placeholder="Select one or many campaigns" id="ddlServiceTypeID1"
                                                        ng-model="SearchParam.ServiceId">
                                                    <option ng-repeat="item in CampaignList" value="{{item.ID}}">{{item.ServiceName}}</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Project</label>
                                                <select class="form-control select2" style="width: 100%;"
                                                        data-placeholder="Select project" id="ddlProjectID"
                                                        ng-model="SearchParam.ProjectID">
                                                    <option ng-repeat="item in ProjectList" value="{{item.ID}}">{{item.ProjectName}}</option>
                                                </select>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="col-md-12">
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Start date</label>
                                                <div class="input-group date">
                                                    <div class="input-group-addon">
                                                        <i class="fa fa-calendar"></i>
                                                    </div>
                                                    <input type="text" class="form-control dateControl" ng-model="SearchParam.FromDate"
                                                           data-format="dd-mm-yyyy" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>End date</label>
                                                <div class="input-group date">
                                                    <div class="input-group-addon">
                                                        <i class="fa fa-calendar"></i>
                                                    </div>
                                                    <input type="text" class="form-control dateControl" ng-model="SearchParam.ToDate"
                                                           data-format="dd-mm-yyyy" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Status</label>
                                                <select class="form-control" style="width: 100%;"
                                                        data-placeholder="Select status"
                                                        ng-model="SearchParam.Status">
                                                    <option value="1">Success</option>
                                                    <option value="0">Unsuccess</option>
                                                    <option value="2">Call back</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Agent (extension)</label>
                                                <input type="text" class="form-control" ng-model="SearchParam.Agent" ng-change="SetPaging()" />
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Report type</label>
                                                <select class="form-control" style="width: 100%;"
                                                        data-placeholder="Select report type"
                                                        ng-model="SearchParam.ReportType">
                                                    <option value="SURVEYRESULT">Campaign result</option>
                                                    <option value="CALLHISTORY">Calls history</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-1">
                                            <div class="form-group fix-chk-mg">
                                                <button type="button" class="btn btn-block btn-success btn-sm" ng-click="ExportResult()">
                                                    <i class="fa fa-file-excel-o"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="col-md-2 pull-left">
                                            <div class="form-group">
                                                <button type="submit" class="btn btn-block btn-info btn-sm">
                                                    <strong>Search</strong>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-md-2 pull-left">
                                            <div class="form-group">
                                                <button type="button" class="btn btn-block btn-pinterest btn-sm" ng-click="Reset()">
                                                    <strong>Clear</strong>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div class="box box-info">
                            <div class="box-header with-border">
                                <h3 class="box-title">Call List</h3>
                                <div class="box-tools pull-right">
                                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                                    <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
                                </div>
                            </div>
                            <div class="box-body">
                                <div class="col-md-12 table-responsive no-padding">
                                    <simple-pagination current-page="settings.currentPage"
                                                       offset="settings.offset"
                                                       page-limit="settings.pageLimit"
                                                       page-limits="settings.pageLimits"
                                                       on-update="callback()"
                                                       total="ListSearchCall.length"></simple-pagination>
                                    <br />
                                    <table id="tblSearchCall" class="table table-bordered">
                                        <thead>
                                            <tr class="bg-blue-active">
                                                <th>Action</th>
                                                <th>Campaign</th>
                                                <th>Project</th>
                                                <th>Customer Code</th>
                                                <th>VNZ0Code</th>
                                                <th>Customer Name</th>
                                                @*<th>Phone Number</th>*@
                                                <th>Employee Name</th>
                                                <th>SalemanCode</th>
                                                <th>Contract</th>
                                                <th>Agent</th>
                                                <th>Calling Date</th>
                                                <th>Start Time</th>
                                                <th>End Time</th>
                                                <th>Talk Time (seconds)</th>
                                                <th>Call Back</th>
                                                <th>Update by</th>
                                                <th>Update date</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="item in filterData = (ListSearchCall | filter : {Agent: SearchParam.Agent} | limitTo:settings.pageLimit:settings.offset)"
                                                ng-class-odd="'tr_odd'" ng-class-even="">
                                                <td>
                                                    <span ng-if="(UserSession.UserId != null && UserSession.UserId == item.UserId) || (UserSession.IsAdmin != null && UserSession.IsAdmin != '')">
                                                        <a class="btn bg-light-blue-active btn-sm" ng-href="@Url.Action("Index", "DoCampaign")?SurveyVoteID={{item.Id}}"
                                                           data-toggle="modal" title="Update Survey">
                                                            <i class="fa fa-pencil"></i>
                                                        </a>
                                                    </span>
                                                    <span ng-if="UserSession.UserId != null && UserSession.UserId == item.UserId">
                                                        <button type="button" title="Delete Survey" ng-click="DeleteSurvey(item)" class="btn btn-pinterest btn-sm"
                                                                data-toggle="modal">
                                                            <i class="fa fa-trash-o"></i>
                                                        </button>
                                                    </span>
                                                </td>
                                                <td>{{item.Campaign}}</td>
                                                <td>{{item.ProjectName}}</td>
                                                <td class="text-bold">{{item.CustomerCode}}</td>
                                                <td class="text-bold">{{item.VNZ0Code}}</td>
                                                <td>{{item.CustomerName}}</td>
                                                @*<td>{{item.CustomerPhone}}</td>*@
                                                <td>{{item.EmployeeName}}</td>
                                                <td>{{item.SalemanCode}}</td>
                                                <td>{{item.contracts}}</td>
                                                <td>{{item.Agent}}</td>
                                                <td>{{item.CallingDate}}</td>
                                                <td>{{item.StartTime}}</td>
                                                <td>{{item.EndTime}}</td>
                                                <td class="text-right">{{item.TalkTime | number}}</td>
                                                <td>{{item.CallBackDate}}</td>
                                                <td>{{item.UpdateBy}}</td>
                                                <td>{{item.UpdateDate}}</td>
                                                <td>
                                                    <span ng-if="item.Status == '1'">
                                                        <small class="label label-success">
                                                            <b>Success</b>
                                                        </small>
                                                    </span>
                                                    <span ng-if="item.Status == '0'">
                                                        <small class="label label-danger">
                                                            <b>Unsuccess</b>
                                                        </small>
                                                    </span>
                                                    <span ng-if="item.Status == '2'">
                                                        <small class="label label-info">
                                                            <b>Call back</b>
                                                        </small>
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <simple-pagination current-page="settings.currentPage"
                                                       offset="settings.offset"
                                                       page-limit="settings.pageLimit"
                                                       page-limits="settings.pageLimits"
                                                       on-update="callback()"
                                                       total="ListSearchCall.length"></simple-pagination>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- END SEARCH CALL FORM -->
                    <!-- BEGIN Effective Campaign History -->
                    <div class="tab-pane" id="EffectiveCampaignHistory">
                        <div class="box box-info">
                            <div class="box-header with-border">
                                <h3 class="box-title">Effective calls</h3>
                                <div class="box-tools pull-right">
                                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                                    <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
                                </div>
                            </div>
                            <div class="box-body">
                                <form ng-submit="SearchEffectiveCampaignHistory()" name="formSearch" method="get">
                                    <div class="col-md-12">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Customer Code</label>
                                                <input type="text" class="form-control" ng-model="SearchParam.CustomerCode"
                                                       placeholder="Customers code separate by comma (,)" ng-change="SetPaging()" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Contract</label>
                                                <select class="form-control" style="width: 100%;"
                                                        data-placeholder="Select report type"
                                                        ng-model="SearchParam.contracts">
                                                    <option value="VIME">VIME</option>
                                                    <option value="DKSH">DKSH</option>
                                                    <option value="GIGAMED">GIGAMED</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-5">
                                            <div class="form-group has-error">
                                                <label>Campaign</label>
                                                <select class="form-control select2" style="width: 100%;" multiple
                                                        data-placeholder="Select one or many campaigns" id="ddlServiceTypeID2"
                                                        ng-model="SearchParam.ServiceId">
                                                    <option ng-repeat="item in CampaignList" value="{{item.ID}}">{{item.ServiceName}}</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Start date</label>
                                                <div class="input-group date">
                                                    <div class="input-group-addon">
                                                        <i class="fa fa-calendar"></i>
                                                    </div>
                                                    <input type="text" class="form-control dateControl" ng-model="SearchParam.FromDate"
                                                            data-format="dd-mm-yyyy" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>End date</label>
                                                <div class="input-group date">
                                                    <div class="input-group-addon">
                                                        <i class="fa fa-calendar"></i>
                                                    </div>
                                                    <input type="text" class="form-control dateControl" ng-model="SearchParam.ToDate"
                                                            data-format="dd-mm-yyyy" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Status</label>
                                                <select class="form-control" style="width: 100%;"
                                                        data-placeholder="Select status"
                                                        ng-model="SearchParam.Status">
                                                    <option value="">---All---</option>
                                                    <option value="1">Success</option>
                                                    <option value="0">Unsuccess</option>
                                                    <option value="2">Call back</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Agent</label>
                                                <input type="text" class="form-control" ng-model="SearchParam.Agent" ng-change="SetPaging()" />
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Report type</label>
                                                <select class="form-control" style="width: 100%;"
                                                        data-placeholder="Select report type"
                                                        ng-model="SearchParam.ReportType">
                                                    <option value="CALL_CAMPAIGN_HISTORY">Call history</option>
                                                    <option value="EFFECTIVE_CAMPAIGN_HISTORY">Survey result</option>
                                                    <option value="SFE_REPORT">SFE Report</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-1">
                                            <div class="form-group fix-chk-mg">
                                                <button type="button" class="btn btn-block btn-success btn-sm" ng-click="ExportResult()">
                                                    <i class="fa fa-file-excel-o"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>                                    
                                    <div class="col-md-12">
                                        <div class="col-md-2 pull-left">
                                            <div class="form-group">
                                                <button type="submit" class="btn btn-block btn-info btn-sm">
                                                    <strong>Search</strong>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-md-2 pull-left">
                                            <div class="form-group">
                                                <button type="button" class="btn btn-block btn-pinterest btn-sm" ng-click="Reset()">
                                                    <strong>Clear</strong>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                                <div class="col-md-12">
                                    <simple-pagination current-page="settings.currentPage"
                                                       offset="settings.offset"
                                                       page-limit="settings.pageLimit"
                                                       page-limits="settings.pageLimits"
                                                       on-update="callback()"
                                                       total="EffectiveCampaignHistoryList.length"></simple-pagination>
                                </div>
                            </div>
                        </div>
                        <div class="box box-info">
                            <div class="box-header with-border">
                                <h3 class="box-title">Call List</h3>
                                <div class="box-tools pull-right">
                                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                                    <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
                                </div>
                            </div>
                            <div class="box-body">
                                <div class="col-md-12 table-responsive no-padding">                                    
                                    <br />
                                    <table id="tblEffectiveCampaignHistory" class="table table-bordered">
                                        <thead>
                                            <tr class="bg-blue-active">
                                                <th>Campaign</th>
                                                <th>Customer Code</th>
                                                <th>VNZ0Code</th>
                                                <th>Customer Name</th>
                                                @*<th>Phone Number</th>*@
                                                <th>Employee Name</th>
                                                <th>SalemanCode</th>
                                                <th>Agent</th>
                                                <th>Contract</th>
                                                <th>Calling Date</th>
                                                <th>Start Time</th>
                                                <th>End Time</th>
                                                <th>Talk Time (seconds)</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="item in filterData = (EffectiveCampaignHistoryList | filter : {Agent: SearchParam.Agent} | limitTo:settings.pageLimit:settings.offset)"
                                                ng-class-odd="'tr_odd'" ng-class-even="">
                                                <td>{{item.Campaign}}</td>
                                                <td class="text-bold">{{item.CustomerCode}}</td>
                                                <td class="text-bold">{{item.VNZ0Code}}</td>
                                                <td>{{item.CustomerName}}</td>
                                                @*<td>{{item.CustomerPhone}}</td>*@
                                                <td>{{item.EmployeeName}}</td>
                                                <td>{{item.SalemanCode}}</td>
                                                <td>{{item.Agent}}</td>
                                                <td>{{item.contracts}}</td>
                                                <td>{{item.CallingDate}}</td>
                                                <td>{{item.StartTime}}</td>
                                                <td>{{item.EndTime}}</td>
                                                <td class="text-right">{{item.TalkTime | number}}</td>
                                                <td>
                                                    <span ng-if="item.Status == '1'">
                                                        <small class="label label-success">
                                                            <b>Success</b>
                                                        </small>
                                                    </span>
                                                    <span ng-if="item.Status == '0'">
                                                        <small class="label label-danger">
                                                            <b>Unsuccess</b>
                                                        </small>
                                                    </span>
                                                    <span ng-if="item.Status == '2'">
                                                        <small class="label label-info">
                                                            <b>Call back</b>
                                                        </small>
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    
                                </div>
                                <div class="col-md-12">
                                    <simple-pagination current-page="settings.currentPage"
                                                       offset="settings.offset"
                                                       page-limit="settings.pageLimit"
                                                       page-limits="settings.pageLimits"
                                                       on-update="callback()"
                                                       total="EffectiveCampaignHistoryList.length"></simple-pagination>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- END Effective Campaign History -->
                </div>
            </div>
        </div>
    </div>        
</section>
</div>
<script src="~/Scripts/Controller/SearchCallController.js"></script>
<!-- bootstrap time picker -->
<script src="/plugins/timepicker/bootstrap-timepicker.min.js"></script>
<script type="text/javascript">
    $(function () {
        //Date picker
        var currentDate = new Date();
        $('.dateControl').datepicker({
            autoclose: true,
            format: 'dd-mm-yyyy',
            todayHighlight: true,
            orientation: 'bottom'
        });
        $('.dateControl').datepicker('setDate', currentDate);
        
        $('.monthControl').datepicker({
            autoclose: true,
            format: 'mm-yyyy',
            viewMode: "months",
            minViewMode: "months",
            orientation: 'bottom',
            useCurrent: true,
        });

        $('.select2').select2();
        //Timepicker
        $('.timepicker').timepicker({
            showInputs: false,
            minuteStep: 1
        })
    })
</script>