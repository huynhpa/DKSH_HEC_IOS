@{
    ViewBag.Title = "Assignment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style type="text/css">
    th, td {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    #tblAssignment th {
        text-align: center;
        vertical-align: middle;
    }

    #tbl td {
        vertical-align: middle;
    }

    .color-col {
        background-color: #C2EEFA;
    }

    .fix-modal-body {
        overflow-y: scroll;
        max-height: 600px;
    }

    .dateControl {
    }

    .editor {
    }

    .fix-chk-mg {
        margin-top: 22px;
    }

    .tr_odd {
        background-color: #BDF4FE;
    }

    .bg-blue-sky {
        background-color: #86D7FA;
    }
</style>
<div class="ng-cloak" ng-controller="AssignmentController">
    <section class="content-header">
        <h1>
            Assignment
            <small>Control panel</small>
        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i>Home</a></li>
            <li>Campaign Management</li>
            <li class="active">Assignment</li>
        </ol>
    </section>
    <section class="content">
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title">Search</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                    <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
                </div>
            </div>
            <!-- /.box-header -->
            <div class="box-body">
                <form ng-submit="ViewAssignment()" name="formAssignment" method="get">
                    <div class="col-md-12">
                        <div class="col-md-5">
                            <div class="form-group">
                                <label class="text-red">Project</label>
                                <select class="form-control select2" style="width: 100%;"
                                        data-placeholder="Select a project"
                                        id="ddlProject"
                                        ng-model="AssignmentDto.ProjectID"
                                        ng-options="item as item.ProjectName for item in ServiceTypeList">
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Agents</label>
                                <select class="form-control select2" style="width: 100%;"
                                        data-placeholder="Select a agent"
                                        ng-model="AssignmentDto.UserId">
                                    <option value="">---SELECT ALL---</option>
                                    <option ng-repeat="item in AgentList" value="{{item.WindowsUser}}">{{item.AgentNumber}}-{{item.FullName}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="col-md-2 pull-left">
                            <div class="form-group">
                                <button type="submit" class="btn btn-block btn-sm btn-success">
                                    <i class="fa fa-refresh text-bold"></i>&nbsp;<strong>Refresh</strong>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2 pull-left">
                            <div class="form-group">
                                <button type="button" class="btn btn-block btn-sm btn-pinterest" ng-click="Clear()">
                                    <strong>Reset</strong>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2 pull-right">
                            <div class="form-group">
                                <button type="button" class="btn btn-block btn-sm btn-warning"
                                        ng-click="RemoveAssignment()">
                                    <strong>Remove</strong>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
                <div class="col-md-12">
                    <simple-pagination current-page="settings.currentPage"
                                       offset="settings.offset"
                                       page-limit="settings.pageLimit"
                                       page-limits="settings.pageLimits"
                                       on-update="callback()"
                                       total="ListAssignment.length"></simple-pagination>
                </div>
            </div>
        </div>
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title">Assignment</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                    <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
                </div>
            </div>
            <div class="box-body">
                <div class="col-md-12 table-responsive no-padding">
                    <table id="tblAssignment" class="table table-bordered table-striped">
                        <thead>
                            <tr class="bg-blue-sky">
                                <th>Active Campaign</th>
                                <th>Is Assigned</th>
                                <th>Total Customer</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in filterData = (ListAssignment | limitTo:settings.pageLimit:settings.offset)">                                
                                <td>{{item.ServiceName}}</td>
                                <td class="text-center">
                                    <span ng-if="item.IsAssigned == true">
                                        <small class="label text-center bg-green">{{item.IsAssigned}}</small>
                                    </span>
                                </td>
                                <td class="text-right">{{item.TotalCustomer | number}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>
<script src="~/Scripts/Controller/AssignmentController.js"></script>
<script src="/plugins/timepicker/bootstrap-timepicker.min.js"></script>
<script type="text/javascript">
    $(function () {
        //Date picker
        var currentDate = new Date();
        $('.dateControl').datepicker({
            autoclose: true,
            format: 'dd-mm-yyyy',
            todayHighlight: true,
            orientation: 'bottom'
        });

        $('.select2').select2();
        //Timepicker
        $('.timepicker').timepicker({
            showInputs: false,
            minuteStep: 1
        });
    })
</script>