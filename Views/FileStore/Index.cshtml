@model DKSHApplication.DTO.FileStoreDto
@{
    ViewBag.Title = "File store";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var userSession = (DKSHApplication.DTO.UserDto)Session["USER_SESSION"];
}
<style type="text/css">
    .fix-height-30 {
        height: 30px;
        vertical-align: middle;
    }

    th, td {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    th, td {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    #tblFileStore th {
        text-align: center;
        vertical-align: middle;
    }

    #tblFileStore td {
        vertical-align: middle;
    }

    .fix-modal-body {
        overflow-y: scroll;
        max-height: 700px;
    }

    .dateControl {
    }
</style>
<div ng-cloak ng-controller="FileStoreController">
    <section class="content-header">
        <h1>
            File Management
            <small>Control panel</small>
        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i>Home</a></li>
            <li class="active">File Management</li>
        </ol>
    </section>
    <section class="content">
        <!-- ROLE -->
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title">Search</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                    <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
                </div>
            </div>
            <!-- /.box-header -->
            <div class="box-body">
                <div class="col-md-12">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>File Name</label>
                            <input type="text" class="form-control" ng-model="SearchModel.FileName" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Ticket No</label>
                            <select class="form-control select2" style="width: 100%;" ng-model="SearchModel.RequestId" ng-change="SetPaging()">
                            @if (ViewBag.TicketNoList != null)
                            {
                                foreach (var item in ViewBag.TicketNoList)
                                {
                                <option value="@item.TicketId">@item.TicketName</option>
                                }
                            }                            
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Issue No</label>
                            <select class="form-control select2" style="width: 100%;" ng-model="SearchModel.IssueId" ng-change="SetPaging()">
                            @if (ViewBag.IssueNoList != null)
                            {
                                foreach (var item in ViewBag.IssueNoList)
                                {
                                <option value="@item.Id">@item.IssueNo - @item.Title</option>
                                }
                            }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-2 pull-left">
                        <div class="form-group">
                            <button type="button" class="btn btn-block btn-success" ng-click="SearchFile()">
                                Search
                            </button>
                        </div>
                    </div>
                    <div class="col-md-2 pull-left">
                        <div class="form-group">
                            <button type="button" class="btn btn-block btn-danger" ng-click="ClearForm()">
                                Clear
                            </button>
                        </div>
                    </div>
                    <div class="col-md-2 pull-right">
                        <div class="form-group">
                            <button type="button" class="btn btn-block btn-info" id="btnUpload"
                                    data-backdrop="static" data-keyboard="false"
                                    data-toggle="modal" data-target="#mdFileStore">
                                <span><i class="fa fa-cloud-upload"></i></span>
                                Upload file
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-4">
                        <div class="form-group">
                            <h5>
                                <label>
                                    <span class="label label-info"><b>{{totalItems}} file(s)</b></span>
                                </label>
                            </h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title">File List</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                    <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
                </div>
            </div>
            <div class="box-body">
                <div class="col-md-12 table-responsive no-padding">
                    <simple-pagination current-page="settings.currentPage"
                                       offset="settings.offset"
                                       page-limit="settings.pageLimit"
                                       page-limits="settings.pageLimits"
                                       on-update="callback()"
                                       total="FileStoreList.length"></simple-pagination>
                    <br />
                    <table id="tblFileStore" class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>File Name</th>
                                <th>Ticket No</th>
                                <th>Issue No</th>
                                <th>Create By</th>
                                <th>Create Date</th>
                                <th>File Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in filterData = (FileStoreList | filter : { FileName: SearchModel.FileName,
                                                                                            RequestId: SearchModel.RequestId,
                                                                                            IssueId: SearchModel.IssueId}
                                                                    | limitTo:settings.pageLimit:settings.offset)">
                                <td class="text-center">
                                    <span>                                        
                                        <a class="btn btn-info" title="Download" 
                                           ng-href="@Url.Action("DownLoadFile","FileStore")?fileName={{item.FileName}}&fileType={{item.FileType}}&ticketNo={{item.TicketNo}}">
                                            <i class="fa fa-cloud-download"></i>
                                        </a>
                                    </span>
                                </td>
                                <td class="text-bold">{{item.FileName}}</td>
                                <td>{{item.TicketNo}}</td>
                                <td class="text-right">{{item.IssueNo}}</td>
                                <td>{{item.CreateBy}}</td>
                                <td class="text-right">{{item.CreateDate}}</td>
                                <td class="text-center">
                                    <small class="{{item.FileType}}"></small>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
    <!-- MODAL DIALOG -->    
    <div id="mdFileStore" class="modal fade" role="dialog">
        <div class="modal-dialog" style="width: 85%; margin: 40px auto;">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title text-red">File Information</h4>
                </div>
                @using (Html.BeginForm("UploadFiles", "FileStore", FormMethod.Post, new { @id = "uploadForm", enctype = "multipart/form-data" }))
                {
                @Html.AntiForgeryToken()
                <div class="modal-body fix-modal-body">
                    <div class="box box-info">
                        <div class="box-header with-border">
                            <h3 class="box-title"></h3>
                            <div class="box-tools pull-right">
                                <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                            </div>
                        </div>

                        <div class="box-body">
                            <div class="col-md-12">
                                <div class="col-md-5">
                                    <div class="form-group">
                                        <label class="text-red">Ticket No. (*)</label>
                                        <select class="form-control select2" id="RequestId" style="width: 100%;" ng-model="FileModel.RequestId" ng-change="GetIssueNoByTicket(FileModel.RequestId)">
                                            @if (ViewBag.TicketNoList != null)
                                            {
                                                foreach (var item in ViewBag.TicketNoList)
                                                {
                                                <option value="@item.TicketId">@item.TicketName - @item.Title</option>
                                                }
                                            }
                                        </select>
                                        @Html.TextBoxFor(model => model.RequestId, "", new { @class = "form-control", @type = "hidden", @id = "txtRequestId", ng_model = "FileModel.RequestId" })
                                        @Html.TextBoxFor(model => model.TicketNo, "", new { @class = "form-control", @type = "hidden", @id = "txtTicketNo", ng_model = "FileModel.TicketNo" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Issue No.</label>
                                        <select class="form-control select2" id="IssueNo" style="width: 100%;" ng-model="FileModel.IssueId" ng-change="GetIssueValue()">
                                            <option ng-repeat="item in IssueNoList" value="{{item.Id}}">{{item.IssueNo}}-{{item.Title}}</option>
                                        </select>
                                        @Html.TextBoxFor(model => model.IssueId, "", new { @class = "form-control", @id = "txtIssueId", @type = "hidden", ng_model = "FileModel.IssueNo" })
                                        @Html.TextBoxFor(model => model.IssueNo, "", new { @class = "form-control", @id = "txtIssueNo", @type = "hidden" })
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="text-red">File upload (*)</label>
                                        @Html.TextBoxFor(model => model.files, "", new { @class = "form-control", @id = "fileUpload", @type = "file", @multiple = "multiple" })
                                    </div>
                                </div>
                            </div>                            
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-info"><span><i class="fa fa-cloud-upload"></i></span> Submit</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal" ng-click="Cancel()">Cancel</button>
                </div>
                }              
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/Controller/FileStoreController.js"></script>
<script type="text/javascript">
    $(function () {
        $('.select2').select2();
        $('#uploadForm').submit(function() {
            if (IsNullOrEmpty($('#txtRequestId').val())) {
                ErrorMessage("Ticket No. is required !");
                return false;
            }
            if (IsNullOrEmpty($('#fileUpload').val())) {
                ErrorMessage("Files upload is required !");
                return false;
            }
            return true;
        });
    })
</script>


